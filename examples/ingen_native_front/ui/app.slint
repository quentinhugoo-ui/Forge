    in property <image> banger_frame_image;
    in property <image> google_logo_image;
    in property <image> work_motion_image;
    in property <image> profile_banner_image;
    in property <image> brain_motion_image;
    in property <image> profile_avatar_image;
    in property <string> upload_status;
    in property <string> upload_preview_label;
    in property <string> upload_preview_kind;
    in property <image> upload_preview_image;
    in property <bool> upload_preview_is_image: false;
    in property <int> upload_count: 0;
    in property <string> upload_error_text;
    in-out property <string> upload_error_full;
    in-out property <int> upload_preview_frame: 0;
    in-out property <int> upload_preview_scroll_offset: 0;
    in property <string> banger_frame_hash;
    in property <string> banger_bridge_hash;
    in property <string> atlas_tree_lines;
    in property <string> atlas_selected_summary;
    in property <string> atlas_ax_summary;
    in property <string> atlas_layout_summary;
    in property <string> atlas_resource_lines;
    in property <string> atlas_action_candidates;
    in property <string> atlas_blind_spot_lines;
    in property <string> atlas_proof_summary;
    in property <string> atlas_search_summary;
    in-out property <bool> left_panel_open: true;
    in-out property <bool> right_panel_open: true;
    in-out property <string> profile_canvas: "";
    in-out property <bool> profile_avatar_ready: false;
    in-out property <string> llm_selected_provider: "openai";
    in-out property <bool> llm_openai_connected: false;
    in-out property <bool> llm_anthropic_connected: false;
    in-out property <bool> llm_openrouter_connected: false;
    in-out property <string> brain_safe_tune_text: "";
    in-out property <string> permission_mode: "ask-permissions";
    in-out property <bool> permission_mode_open: false;
    in-out property <bool> sessions_menu_open: false;
    in-out property <string> sessions_menu_mode: "recents";
    in property <string> recent_session_id;
    in property <bool> recent_session_visible: false;
    in property <string> recent_session_label;
    in property <string> recent_session_date;
    in property <string> recent_session_section: "forge";
    in property <string> archived_session_id;
    in-out property <bool> has_archived_session: false;
    in-out property <string> archived_session_label: "";
    in-out property <string> archived_session_date: "";
    in-out property <string> archived_session_section: "forge";
    in property <bool> mac_chrome: false;
    out property <length> workspace_left: root.left_panel_open ? 287px : 0px;
    in property <bool> modal_visible;
    in property <string> modal_title;
    in property <string> modal_body;
    in-out property <string> chat_text;
    in-out property <string> chat_text_openai;
    in-out property <string> chat_text_anthropic;
    in-out property <string> chat_text_openrouter;
    in-out property <bool> llm_openai_active: false;
    in-out property <bool> llm_anthropic_active: false;
    in-out property <bool> llm_openrouter_active: false;
    in-out property <string> llm_connect_prompt_provider: "";
    in-out property <int> llm_model_index: 0;
    in-out property <int> llm_reasoning_index: 1;
    in-out property <int> llm_model_flip_tick: 0;
    in-out property <int> llm_reasoning_flip_tick: 0;
    callback refresh_probes();
    callback navigate(string);
    callback select_session(string);
    callback open_google_webview();
    callback activate_imported_control(string);
    callback window_close();
    callback window_minimize();
    callback window_toggle_maximize();
    callback navigate_next();
    callback send_chat();
    callback chat_text_edited();
    callback attach_files();
    callback attach_profile_avatar();
    callback upload_preview_scroll(int);
    callback close_modal();
    callback atlas_previous_node();
    callback atlas_next_node();
    callback connect_llm_provider(string);
    callback cycle_llm_model(string, int);
    callback cycle_llm_reasoning(int);
    callback archive_session(string);

    title: "";
    no-frame: true;
    default-font-family: "Geist";
    preferred-width: 1535px;
    preferred-height: 786px;
    min-width: 1180px;
    min-height: 760px;
    background: #0e0e0f;

    FocusScope {
        KeyBinding { keys: @keys(Control+Tab); activated => { root.navigate_next(); } }
        KeyBinding { keys: @keys(Escape); activated => { root.close_modal(); } }
    }

    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: #0e0e0f; }
    LeftPanel {
        x: root.left_panel_open ? 8px : -287px;
        y: 38px;
        height: root.height - 48px;
        opacity: root.left_panel_open ? 1.0 : 0.0;
        active_section: root.active_section;
        cpu_label: root.left_cpu_label;
        gpu_label: root.left_gpu_label;
        work_motion_image: root.work_motion_image;
        recent_session_id: root.recent_session_id;
        recent_session_visible: root.recent_session_visible;
        recent_session_label: root.recent_session_label;
        recent_session_date: root.recent_session_date;
        recent_session_section: root.recent_session_section;
        archived_session_id: root.archived_session_id;
        has_archived_session <=> root.has_archived_session;
        archived_session_label <=> root.archived_session_label;
        archived_session_date <=> root.archived_session_date;
        archived_session_section <=> root.archived_session_section;
        navigate(section) => { root.profile_canvas = ""; root.navigate(section); }
        open_session(id, section) => { root.profile_canvas = ""; root.select_session(id); root.navigate(section); }
        activate_control(label) => { root.activate_imported_control(label); }
        open_profile_canvas(target) => { root.profile_canvas = target; }
        archive_session(session_id) => { root.archive_session(session_id); }
    }
    WorkspaceHeader {
        visible: root.profile_canvas != "brain";
        x: root.workspace_left;
        y: 44px;
        width: root.width - root.workspace_left;
        active_section: root.active_section;
        section_title: root.section_title;
        navigate(section) => { root.profile_canvas = ""; root.navigate(section); }
        toggle_right_panel => { root.right_panel_open = !root.right_panel_open; }
    }
    DropCanvas {
        visible: root.profile_canvas == "" && root.active_section != "webexplorer";
        x: root.workspace_left;
        y: 96px;
        width: root.width - root.workspace_left;
        height: root.height - 96px;
        active_section: root.active_section;
        canvas_title: root.canvas_title;
        canvas_hint: root.canvas_hint;
        activate_control(label) => { root.activate_imported_control(label); }
    }
    GoogleWebViewCanvas {
        visible: root.profile_canvas == "" && root.active_section == "webexplorer";
        x: root.workspace_left;
        y: 96px;
        width: root.width - root.workspace_left;
        height: root.height - 96px;
        active_section: root.active_section;
        native_webexplorer_status: root.native_webexplorer_status;
        webview_status: root.webview_status;
        google_logo_image: root.google_logo_image;
    }
    BangerNativeViewport {
        visible: root.profile_canvas == "" && root.active_section == "banger";
        x: root.workspace_left;
        y: 96px;
        width: root.width - root.workspace_left;
        height: root.height - 96px;
        active_section: root.active_section;
        frame_image: root.banger_frame_image;
        frame_hash: root.banger_frame_hash;
        bridge_hash: root.banger_bridge_hash;
        activate_control(label) => { root.activate_imported_control(label); }
    }
    AtlasInspector {
        visible: root.profile_canvas == "" && root.active_section == "webexplorer";
        x: root.workspace_left;
        y: 96px;
        width: root.width - root.workspace_left;
        height: root.height - 96px;
        active_section: root.active_section;
        tree_lines: root.atlas_tree_lines;
        selected_summary: root.atlas_selected_summary;
        ax_summary: root.atlas_ax_summary;
        layout_summary: root.atlas_layout_summary;
        resource_lines: root.atlas_resource_lines;
        action_candidates: root.atlas_action_candidates;
        blind_spot_lines: root.atlas_blind_spot_lines;
        proof_summary: root.atlas_proof_summary;
        search_summary: root.atlas_search_summary;
        previous_node => { root.atlas_previous_node(); }
        next_node => { root.atlas_next_node(); }
    }
    AgentSurface {
        visible: false;
        x: root.workspace_left;
        y: 96px;
        width: root.width - root.workspace_left;
        height: root.height - 96px;
        active_section: root.active_section;
        session_lines: root.session_lines;
        transcript_lines: root.transcript_lines;
        plan_cards: root.plan_cards;
        questionnaire_cards: root.questionnaire_cards;
        proof_cards: root.proof_cards;
        agent_surface_status: root.agent_surface_status;
    }
    ProductSectionSurface {
        visible: root.profile_canvas == "" && (root.active_section == "trading" || root.active_section == "real-estate" || root.active_section == "alpha");
        x: root.workspace_left;
        y: 96px;
        width: root.width - root.workspace_left;
        height: root.height - 96px;
        active_section: root.active_section;
        title: root.product_section_title;
        status: root.product_section_status;
        metric_lines: root.product_section_metrics;
        card_lines: root.product_section_cards;
        action_lines: root.product_section_actions;
        proof_summary: root.product_section_proof;
        activate_control(label) => { root.activate_imported_control(label); }
    }
    PoolClawProfileSurface {
        visible: root.profile_canvas == "profile";
        x: root.workspace_left;
        y: 96px;
        width: root.width - root.workspace_left;
        height: root.height - 96px;
        mode: root.profile_canvas;
        banner_image: root.profile_banner_image;
        avatar_image: root.profile_avatar_image;
        avatar_ready: root.profile_avatar_ready;
        attach_avatar => { root.attach_profile_avatar(); }
    }
    LlmProvidersSurface {
        visible: root.profile_canvas == "llm";
        x: root.workspace_left;
        y: 96px;
        width: root.width - root.workspace_left;
        height: root.height - 96px;
        mode: root.profile_canvas;
        selected_provider <=> root.llm_selected_provider;
        openai_connected <=> root.llm_openai_connected;
        anthropic_connected <=> root.llm_anthropic_connected;
        openrouter_connected <=> root.llm_openrouter_connected;
        connect_provider(provider) => { root.connect_llm_provider(provider); }
    }
    BrainSurface {
        visible: root.profile_canvas == "brain";
        x: root.workspace_left;
        y: root.profile_canvas == "brain" ? 44px : 96px;
        width: root.width - root.workspace_left;
        height: root.height - (root.profile_canvas == "brain" ? 44px : 96px);
        mode: root.profile_canvas;
        safe_tune_text <=> root.brain_safe_tune_text;
        brain_motion_image: root.brain_motion_image;
        brain_action(component) => { root.activate_imported_control(component); }
        brain_tune(note) => { root.activate_imported_control(note); root.brain_safe_tune_text = ""; }
    }
    SectionStatusDock {
        visible: root.profile_canvas == "" && root.right_panel_open;
        x: root.width - 314px;
        y: 112px;
        active_section: root.active_section;
        proof_status: root.proof_status;
        gpu_status: root.gpu_status;
        webview_status: root.webview_status;
        hardware_status: root.hardware_status;
        provider_status: root.provider_status;
        job_status: root.job_status;
        proof_badge_status: root.proof_badge_status;
        brain_status: root.brain_status;
        monster_status: root.monster_status;
        native_webexplorer_status: root.native_webexplorer_status;
        banger_status: root.banger_status;
        trading_status: root.trading_status;
        real_estate_status: root.real_estate_status;
        refresh => { root.refresh_probes(); }
        activate_control(label) => { root.activate_imported_control(label); }
    }
    ChatClearanceFade {
        x: root.workspace_left;
        y: root.height - 260px;
        width: root.width - root.workspace_left;
        height: 118px;
    }
    ChatBar {
        x: root.workspace_left + (root.width - root.workspace_left - 780px) / 2;
        y: root.height - 156px;
        chat_text <=> root.chat_text;
        chat_text_openai <=> root.chat_text_openai;
        chat_text_anthropic <=> root.chat_text_anthropic;
        chat_text_openrouter <=> root.chat_text_openrouter;
        permission_mode <=> root.permission_mode;
        permission_mode_open <=> root.permission_mode_open;
        llm_openai_active <=> root.llm_openai_active;
        llm_anthropic_active <=> root.llm_anthropic_active;
        llm_openrouter_active <=> root.llm_openrouter_active;
        llm_selected_provider <=> root.llm_selected_provider;
        llm_connect_prompt_provider <=> root.llm_connect_prompt_provider;
        llm_model_index <=> root.llm_model_index;
        llm_reasoning_index <=> root.llm_reasoning_index;
        llm_model_flip_tick <=> root.llm_model_flip_tick;
        llm_reasoning_flip_tick <=> root.llm_reasoning_flip_tick;
        llm_openai_connected: root.llm_openai_connected;
        llm_anthropic_connected: root.llm_anthropic_connected;
        llm_openrouter_connected: root.llm_openrouter_connected;
        upload_status: root.upload_status;
        upload_preview_label: root.upload_preview_label;
        upload_preview_kind: root.upload_preview_kind;
        upload_preview_image: root.upload_preview_image;
        upload_preview_is_image: root.upload_preview_is_image;
        upload_count: root.upload_count;
        upload_error_text: root.upload_error_text;
        attach_file => { root.attach_files(); }
        edited => { root.chat_text_edited(); }
        select_llm(provider) => { root.activate_imported_control("Select LLM " + provider); }
        open_llm_providers(provider) => { root.profile_canvas = "llm"; root.llm_selected_provider = provider; }
        cycle_llm_model(provider, direction) => { root.cycle_llm_model(provider, direction); }
        cycle_llm_reasoning(direction) => { root.cycle_llm_reasoning(direction); }
        permission_mode_selected(mode) => { root.activate_imported_control("Permission mode " + mode); }
        upload_preview_scroll(direction) => { root.upload_preview_scroll(direction); }
        send => { root.send_chat(); }
    }
    TitleBar {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 38px;
        left_panel_open: root.left_panel_open;
        mac_chrome: root.mac_chrome;
        active_section: root.active_section;
        cpu_label: root.left_cpu_label;
        gpu_label: root.left_gpu_label;
        sessions_menu_open <=> root.sessions_menu_open;
        sessions_menu_mode <=> root.sessions_menu_mode;
        recent_session_id: root.recent_session_id;
        recent_session_visible: root.recent_session_visible;
        recent_session_label: root.recent_session_label;
        recent_session_date: root.recent_session_date;
        recent_session_section: root.recent_session_section;
        archived_session_id: root.archived_session_id;
        has_archived_session: root.has_archived_session;
        archived_session_label: root.archived_session_label;
        archived_session_date: root.archived_session_date;
        archived_session_section: root.archived_session_section;
        toggle_left_panel => { root.left_panel_open = !root.left_panel_open; }
        open_session(id, section) => { root.profile_canvas = ""; root.sessions_menu_open = false; root.select_session(id); root.navigate(section); }
        open_google_webview => { root.profile_canvas = ""; root.open_google_webview(); }
        open_banger_section => { root.profile_canvas = ""; root.navigate("banger"); }
        open_trading_section => { root.profile_canvas = ""; root.navigate("trading"); }
        minimize => { root.window_minimize(); }
        maximize => { root.window_toggle_maximize(); }
        close => { root.window_close(); }
    }
    Text {
        visible: root.dev_status_text != "";
        x: root.workspace_left + 20px;
        y: 40px;
        width: root.width - root.workspace_left - 40px;
        height: 14px;
        text: root.dev_status_text;
        color: root.dev_status_phase == "error" ? #ff5d7a : root.dev_status_phase == "build" ? #ffbf48 : root.dev_status_phase == "live" ? #55e6d3 : #9a9a92;
        font-family: "Geist Mono";
        font-size: 9px;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    NativeModal {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        modal_visible: root.modal_visible;
        modal_title: root.modal_title;
        modal_body: root.modal_body;
        close_modal => { root.close_modal(); }
    }
}
