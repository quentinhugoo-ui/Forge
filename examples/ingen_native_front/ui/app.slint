component ChatClearanceFade inherits Rectangle {
    background: #00000000;
    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height / 5; background: #0e0e0f00; }
    Rectangle { x: 0px; y: parent.height / 5; width: parent.width; height: parent.height / 5; background: #0e0e0f2b; }
    Rectangle { x: 0px; y: parent.height * 2 / 5; width: parent.width; height: parent.height / 5; background: #0e0e0f70; }
    Rectangle { x: 0px; y: parent.height * 3 / 5; width: parent.width; height: parent.height / 5; background: #0e0e0fb8; }
    Rectangle { x: 0px; y: parent.height * 4 / 5; width: parent.width; height: parent.height / 5; background: #0e0e0ff2; }
}

component ChatBar inherits Rectangle {
    in-out property <string> chat_text;
    in-out property <string> chat_text_openai;
    in-out property <string> chat_text_anthropic;
    in-out property <string> chat_text_openrouter;
    in-out property <string> permission_mode: "ask-permissions";
    in-out property <bool> permission_mode_open: false;
    in-out property <bool> llm_openai_active: false;
    in-out property <bool> llm_anthropic_active: false;
    in-out property <bool> llm_openrouter_active: false;
    in-out property <string> llm_selected_provider: "openai";
    in-out property <string> llm_connect_prompt_provider: "";
    in-out property <int> llm_model_index: 0;
    in-out property <int> llm_reasoning_index: 1;
    in-out property <int> llm_model_flip_tick: 0;
    in-out property <int> llm_reasoning_flip_tick: 0;
    in property <bool> llm_openai_connected: false;
    in property <bool> llm_anthropic_connected: false;
    in property <bool> llm_openrouter_connected: false;
    in property <string> upload_status;
    in property <string> upload_preview_label;
    in property <string> upload_preview_kind;
    in property <image> upload_preview_image;
    in property <bool> upload_preview_is_image: false;
    in property <int> upload_count: 0;
    in property <string> upload_error_text;
    property <bool> has_upload: root.upload_count > 0;
    property <string> permission_mode_label: root.permission_mode == "auto-accept-edits" ? "Auto accept edits" : root.permission_mode == "full-autonomy" ? "Full autonomy" : "Ask permissions";
    property <bool> idle_cursor_on: Math.mod(Math.floor(animation-tick() / 560ms), 2) == 0;
    property <bool> openai_selected: root.llm_openai_connected && root.llm_openai_active;
    property <bool> anthropic_selected: root.llm_anthropic_connected && root.llm_anthropic_active;
    property <bool> openrouter_selected: root.llm_openrouter_connected && root.llm_openrouter_active;
    property <int> selected_llm_count: (root.openai_selected ? 1 : 0) + (root.anthropic_selected ? 1 : 0) + (root.openrouter_selected ? 1 : 0);
    property <bool> split_prompts: root.selected_llm_count > 1;
    property <length> prompt_area_width: root.width - 226px;
    property <length> split_prompt_width: root.selected_llm_count == 3 ? root.prompt_area_width / 3 : root.prompt_area_width / 2;
    property <bool> show_connect_prompt: root.llm_connect_prompt_provider != "";
    property <string> status_provider: root.show_connect_prompt ? root.llm_connect_prompt_provider : root.llm_selected_provider;
    property <string> active_model_label: root.status_provider == "anthropic" ? (root.llm_model_index == 2 ? "Haiku 4.5" : root.llm_model_index == 1 ? "Opus 4.8" : "Sonnet 4.6") : root.status_provider == "openrouter" ? (root.llm_model_index == 2 ? "Gemini 2.5" : root.llm_model_index == 1 ? "Qwen 3" : "Auto Route") : (root.llm_model_index == 2 ? "GPT 5.2" : root.llm_model_index == 1 ? "GPT 5.3" : "Codex");
    property <string> reasoning_label: root.llm_reasoning_index == 2 ? "Ã‰levÃ©" : root.llm_reasoning_index == 1 ? "Moyen" : "Faible";
    property <string> connect_prompt_label: root.llm_connect_prompt_provider == "anthropic" ? "Connect Claude" : root.llm_connect_prompt_provider == "openrouter" ? "Connect OpenRouter" : "Connect Codex";
    callback attach_file();
    callback edited();
    callback select_llm(string);
    callback open_llm_providers(string);
    callback cycle_llm_model(string, int);
    callback cycle_llm_reasoning(int);
    callback permission_mode_selected(string);
    callback upload_preview_scroll(int);
    callback send();
    width: 780px;
    height: 99px;
    background: #2a2a28;
    border-radius: 6px;
    Rectangle {
        x: 8px;
        y: 8px;
        width: 83px;
        height: 83px;
        background: #1c1c1b;
        border-radius: 4px;
        border-width: root.has_upload ? 1px : 0px;
        border-color: #eeeee824;
        clip: true;
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #00000055; z: 20; }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #ffffff12; z: 20; }
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: #0000003a; z: 20; }
        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: #ffffff0a; z: 20; }
        Image {
            visible: root.has_upload;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            source: root.upload_preview_image;
            image-fit: cover;
        }
        Rectangle {
            visible: false;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            background: root.upload_preview_kind == "VIDEO" ? #20252b : root.upload_preview_kind == "3D" ? #1f2622 : #232220;
            Rectangle {
                visible: root.upload_preview_kind == "3D";
                x: 9px;
                y: 8px;
                width: parent.width - 18px;
                height: parent.height - 18px;
                background: #00000000;
                clip: true;
                Image {
                    x: 3px;
                    y: 3px;
                    width: parent.width - 6px;
                    height: parent.height - 6px;
                    source: @image-url("data:image/svg+xml;base64,");
                    image-fit: contain;
                    colorize: #f0f0ed;
                    opacity: 0.92;
                }
            }
            Text {
                visible: root.upload_preview_kind != "3D";
                x: 0px;
                y: 23px;
                width: parent.width;
                height: 24px;
                text: root.upload_preview_kind;
                color: #f0f0ed;
                font-size: 16px;
                font-weight: 800;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        Text {
            z: 10;
            x: 2px;
            y: parent.height - 22px;
            width: 18px;
            height: 18px;
            text: "+";
            color: #f0f0edb0;
            font-size: 20px;
            font-weight: 300;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        upload-touch := TouchArea {
            clicked => { root.attach_file(); }
            scroll-event(event) => {
                if (event.delta-y != 0px) {
                    root.upload_preview_scroll(event.delta-y > 0px ? 1 : -1);
                    return accept;
                }
                reject
            }
        }
    }
    Image { x: parent.width - 17px; y: 7px; width: 13px; height: 13px; source: @image-url("data:image/svg+xml;base64,"); }
    Rectangle {
        x: 101px;
        y: 16px;
        width: 1px;
        height: 66px;
        background: #eeeee82c;
    }
    Rectangle {
        x: 112px;
        y: 18px;
        width: parent.width - 226px;
        height: 48px;
        background: #00000000;
        clip: true;
        TouchArea {
            visible: !root.split_prompts;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            clicked => { chat-input.focus(); }
        }
        chat-input := TextInput {
            visible: !root.split_prompts;
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            color: #eeeee8e8;
            font-size: 14px;
            vertical-alignment: center;
            single-line: true;
            selection-background-color: #26d8c34a;
            selection-foreground-color: #f7f7f1;
            text-cursor-width: 1px;
            text <=> root.chat_text;
            accepted => { root.send(); }
            edited => { root.edited(); }
        }
        Rectangle {
            visible: !root.split_prompts && root.chat_text == "";
            x: 0px;
            y: 15px;
            width: 2px;
            height: 18px;
            border-radius: 1px;
            background: root.idle_cursor_on ? #eeeee8d8 : #eeeee800;
            animate background { duration: 160ms; easing: ease; }
        }
        Rectangle {
            visible: root.split_prompts && root.openai_selected;
            x: 0px;
            y: 0px;
            width: root.split_prompt_width - 12px;
            height: parent.height;
            background: #00000000;
            clip: true;
            TextInput {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                color: #eeeee8e8;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: #26d8c34a;
                selection-foreground-color: #f7f7f1;
                text-cursor-width: 1px;
                text <=> root.chat_text_openai;
                accepted => { root.send(); }
                edited => { root.edited(); }
            }
            Rectangle {
                visible: root.chat_text_openai == "";
                x: 0px;
                y: 15px;
                width: 2px;
                height: 18px;
                border-radius: 1px;
                background: root.idle_cursor_on ? #eeeee8b8 : #eeeee800;
                animate background { duration: 160ms; easing: ease; }
            }
        }
        Rectangle {
            visible: root.split_prompts && root.anthropic_selected;
            x: root.openai_selected ? root.split_prompt_width : 0px;
            y: 0px;
            width: root.split_prompt_width - 12px;
            height: parent.height;
            background: #00000000;
            clip: true;
            TextInput {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                color: #eeeee8e8;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: #d9775744;
                selection-foreground-color: #f7f7f1;
                text-cursor-width: 1px;
                text <=> root.chat_text_anthropic;
                accepted => { root.send(); }
                edited => { root.edited(); }
            }
            Rectangle {
                visible: root.chat_text_anthropic == "";
                x: 0px;
                y: 15px;
                width: 2px;
                height: 18px;
                border-radius: 1px;
                background: root.idle_cursor_on ? #eeeee8b8 : #eeeee800;
                animate background { duration: 160ms; easing: ease; }
            }
        }
        Rectangle {
            visible: root.split_prompts && root.openrouter_selected;
            x: (root.openai_selected ? root.split_prompt_width : 0px) + (root.anthropic_selected ? root.split_prompt_width : 0px);
            y: 0px;
            width: root.split_prompt_width - 12px;
            height: parent.height;
            background: #00000000;
            clip: true;
            TextInput {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                color: #eeeee8e8;
                font-size: 13px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: #eeeee844;
                selection-foreground-color: #f7f7f1;
                text-cursor-width: 1px;
                text <=> root.chat_text_openrouter;
                accepted => { root.send(); }
                edited => { root.edited(); }
            }
            Rectangle {
                visible: root.chat_text_openrouter == "";
                x: 0px;
                y: 15px;
                width: 2px;
                height: 18px;
                border-radius: 1px;
                background: root.idle_cursor_on ? #eeeee8b8 : #eeeee800;
                animate background { duration: 160ms; easing: ease; }
            }
        }
        Text {
            visible: root.split_prompts && root.selected_llm_count >= 2;
            x: root.split_prompt_width - 9px;
            y: 5px;
            width: 12px;
            height: 30px;
            text: "/";
            color: #eeeee858;
            font-size: 18px;
            font-weight: 260;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            visible: root.split_prompts && root.selected_llm_count == 3;
            x: root.split_prompt_width * 2 - 9px;
            y: 5px;
            width: 12px;
            height: 30px;
            text: "/";
            color: #eeeee858;
            font-size: 18px;
            font-weight: 260;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 112px;
        y: 82px;
        width: 398px;
        height: 12px;
        text: root.upload_error_text;
        color: #ff5f57;
        font-size: 8px;
        font-family: "Geist Mono";
        overflow: elide;
    }
    Rectangle {
        x: 8px;
        y: 98px;
        width: 430px;
        height: 24px;
        background: #00000000;
        Text {
            visible: !root.permission_mode_open;
            x: 30px;
            y: 0px;
            width: 176px;
            height: parent.height;
            text: root.permission_mode_label;
            color: permission-mode-toggle.has-hover ? #eeeee8e8 : #eeeee8b8;
            font-size: 12px;
            font-weight: 620;
            vertical-alignment: center;
        }
        Image {
            x: 8px;
            y: 7px;
            width: 10px;
            height: 10px;
            source: @image-url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxNiAxNiIgcHJlc2VydmVBc3BlY3RSYXRpbz0ieE1pZFlNaWQgbWVldCI+PHBhdGggZmlsbD0ibm9uZSIgc3Ryb2tlPSIjRjBGMEVEIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiIHN0cm9rZS13aWR0aD0iMS43IiBkPSJtNCA2bDQgNGw0LTQiLz48L3N2Zz4K");
            image-fit: contain;
            opacity: permission-mode-toggle.has-hover ? 0.95 : 0.64;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: root.permission_mode_open ? 180deg : 0deg;
            animate opacity, transform-rotation { duration: 180ms; easing: ease; }
        }
        permission-mode-toggle := TouchArea {
            x: 0px;
            y: 0px;
            width: root.permission_mode_open ? 22px : 220px;
            height: parent.height;
            clicked => { root.permission_mode_open = !root.permission_mode_open; }
        }
        Rectangle {
            visible: root.permission_mode_open;
            x: 26px;
            y: 0px;
            width: 118px;
            height: parent.height;
            background: #00000000;
            opacity: root.permission_mode_open ? 1.0 : 0.0;
            animate opacity { duration: 160ms; easing: ease; }
            Text {
                text: "Ask permissions";
                color: root.permission_mode == "ask-permissions" ? #eeeee8f0 : (ask-permission-touch.has-hover ? #eeeee8d8 : #aaa9a4c8);
                font-size: 12px;
                font-weight: root.permission_mode == "ask-permissions" ? 650 : 520;
                vertical-alignment: center;
            }
            Rectangle { x: 0px; y: 21px; width: 94px; height: 1px; background: root.permission_mode == "ask-permissions" ? #eeeee878 : #00000000; }
            ask-permission-touch := TouchArea { clicked => { root.permission_mode = "ask-permissions"; root.permission_mode_open = false; root.permission_mode_selected("Ask permissions"); } }
        }
        Rectangle {
            visible: root.permission_mode_open;
            x: 152px;
            y: 0px;
            width: 136px;
            height: parent.height;
            background: #00000000;
            opacity: root.permission_mode_open ? 1.0 : 0.0;
            animate opacity { duration: 160ms; easing: ease; }
            Text {
                text: "Auto accept edits";
                color: root.permission_mode == "auto-accept-edits" ? #eeeee8f0 : (auto-edits-touch.has-hover ? #eeeee8d8 : #aaa9a4c8);
                font-size: 12px;
                font-weight: root.permission_mode == "auto-accept-edits" ? 650 : 520;
                vertical-alignment: center;
            }
            Rectangle { x: 0px; y: 21px; width: 104px; height: 1px; background: root.permission_mode == "auto-accept-edits" ? #eeeee878 : #00000000; }
            auto-edits-touch := TouchArea { clicked => { root.permission_mode = "auto-accept-edits"; root.permission_mode_open = false; root.permission_mode_selected("Auto accept edits"); } }
        }
        Rectangle {
            visible: root.permission_mode_open;
            x: 302px;
            y: 0px;
            width: 116px;
            height: parent.height;
            background: #00000000;
            opacity: root.permission_mode_open ? 1.0 : 0.0;
            animate opacity { duration: 160ms; easing: ease; }
            Text {
                text: "Full autonomy";
                color: root.permission_mode == "full-autonomy" ? #eeeee8f0 : (full-autonomy-touch.has-hover ? #eeeee8d8 : #aaa9a4c8);
                font-size: 12px;
                font-weight: root.permission_mode == "full-autonomy" ? 650 : 520;
                vertical-alignment: center;
            }
            Rectangle { x: 0px; y: 21px; width: 82px; height: 1px; background: root.permission_mode == "full-autonomy" ? #eeeee878 : #00000000; }
            full-autonomy-touch := TouchArea { clicked => { root.permission_mode = "full-autonomy"; root.permission_mode_open = false; root.permission_mode_selected("Full autonomy"); } }
        }
    }
    // LLM icon viewboxes: uniform 20x20 containers, 14x14 centered icons
    Rectangle {
        x: parent.width - 106px; y: 69px;
        width: 20px; height: 20px; border-radius: 3px;
        background: #00000000;
        Image { x: 3px; y: 3px; width: 14px; height: 14px; source: @image-url("data:image/svg+xml;base64,"); image-fit: contain; opacity: !root.llm_openai_connected ? 0.24 : root.openai_selected ? 1.0 : (llm-openai-touch.has-hover ? 0.9 : 0.62); }
        Rectangle { x: 5px; y: 18px; width: 10px; height: 1px; background: root.openai_selected ? #eeeee8d8 : #00000000; }
        llm-openai-touch := TouchArea {
            clicked => {
                if (root.llm_openai_connected) {
                    root.llm_openai_active = !root.llm_openai_active;
                    root.llm_connect_prompt_provider = "";
                    root.llm_selected_provider = "openai";
                    root.select_llm("openai");
                } else {
                    root.llm_connect_prompt_provider = "openai";
                    root.open_llm_providers("openai");
                }
            }
        }
    }
    Rectangle {
        x: parent.width - 82px; y: 69px;
        width: 20px; height: 20px; border-radius: 3px;
        background: #00000000;
        Image { x: 3px; y: 3px; width: 14px; height: 14px; source: @image-url("data:image/svg+xml;base64,"); image-fit: contain; opacity: !root.llm_anthropic_connected ? 0.24 : root.anthropic_selected ? 1.0 : (llm-anthropic-touch.has-hover ? 0.92 : 0.66); }
        Rectangle { x: 5px; y: 18px; width: 10px; height: 1px; background: root.anthropic_selected ? #d97757dc : #00000000; }
        llm-anthropic-touch := TouchArea {
            clicked => {
                if (root.llm_anthropic_connected) {
                    root.llm_anthropic_active = !root.llm_anthropic_active;
                    root.llm_connect_prompt_provider = "";
                    root.llm_selected_provider = "anthropic";
                    root.select_llm("anthropic");
                } else {
                    root.llm_connect_prompt_provider = "anthropic";
                    root.open_llm_providers("anthropic");
                }
            }
        }
    }
    Rectangle {
        x: parent.width - 58px; y: 69px;
        width: 20px; height: 20px; border-radius: 3px;
        background: #00000000;
        Image { x: 3px; y: 3px; width: 14px; height: 14px; source: @image-url("data:image/svg+xml;base64,"); image-fit: contain; opacity: !root.llm_openrouter_connected ? 0.24 : root.openrouter_selected ? 1.0 : (llm-openrouter-touch.has-hover ? 0.9 : 0.62); }
        Rectangle { x: 5px; y: 18px; width: 10px; height: 1px; background: root.openrouter_selected ? #eeeee8d8 : #00000000; }
        llm-openrouter-touch := TouchArea {
            clicked => {
                if (root.llm_openrouter_connected) {
                    root.llm_openrouter_active = !root.llm_openrouter_active;
                    root.llm_connect_prompt_provider = "";
                    root.llm_selected_provider = "openrouter";
                    root.select_llm("openrouter");
                } else {
                    root.llm_connect_prompt_provider = "openrouter";
                    root.open_llm_providers("openrouter");
                }
            }
        }
    }
    // Send button: aligned with upload tile bottom
    Rectangle {
        x: parent.width - 34px; y: 65px;
        width: 26px; height: 26px; border-radius: 4px;
        background: send-touch.pressed ? #141413 : (send-touch.has-hover ? #232321 : #1c1c1b);
        animate background { duration: 100ms; easing: ease; }
        Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: #00000055; z: 5; }
        Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #ffffff12; z: 5; }
        Rectangle { x: 0px; y: 0px; width: 1px; height: parent.height; background: #0000003a; z: 5; }
        Rectangle { x: parent.width - 1px; y: 0px; width: 1px; height: parent.height; background: #ffffff0a; z: 5; }
        Image { x: 6px; y: 6px; width: 14px; height: 14px; source: @image-url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI1MTIiIGhlaWdodD0iNTEyIiB2aWV3Qm94PSIwIDAgMjQgMjQiPjxwYXRoIGZpbGw9IiMwMDAwMDAiIGQ9Ik0yMCA0djlhNCA0IDAgMCAxLTQgNEg2LjkxNGwyLjUgMi41TDggMjAuOTE0TDMuMDg2IDE2TDggMTEuMDg2TDkuNDE0IDEyLjVsLTIuNSAyLjVIMTZhMiAyIDAgMCAwIDItMlY0aDJaIi8+PC9zdmc+"); image-fit: contain; colorize: #eeeee8cc; }
        send-touch := TouchArea { clicked => { root.send(); } }
    }
    Rectangle { x: 206px; y: 83px; width: 24px; height: 3px; border-radius: 2px; background: #0a0a0a40; }
    Rectangle {
        visible: !root.show_connect_prompt;
        x: parent.width - 270px;
        y: 98px;
        width: 248px;
        height: 24px;
        background: #00000000;
        Image {
            x: 0px;
            y: 7px;
            width: 9px;
            height: 9px;
            source: @image-url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxNiAxNiIgcHJlc2VydmVBc3BlY3RSYXRpbz0ieE1pZFlNaWQgbWVldCI+PHBhdGggZmlsbD0ibm9uZSIgc3Ryb2tlPSIjRjBGMEVEIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiIHN0cm9rZS13aWR0aD0iMS43IiBkPSJtNCA2bDQgNGw0LTQiLz48L3N2Zz4K");
            image-fit: contain;
            opacity: model-flip-touch.has-hover ? 0.9 : 0.48;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: 90deg + root.llm_model_flip_tick * 360deg;
            animate transform-rotation, opacity { duration: 260ms; easing: ease; }
        }
        model-flip-touch := TouchArea {
            x: -7px;
            y: 0px;
            width: 24px;
            height: parent.height;
            clicked => {
                root.llm_model_index = root.llm_model_index == 2 ? 0 : root.llm_model_index + 1;
                root.llm_model_flip_tick += 1;
                root.cycle_llm_model(root.status_provider, 1);
            }
        }
        Text {
            x: 20px;
            y: 0px;
            width: 118px;
            height: 24px;
            text: root.active_model_label;
            color: #eeeee8bd;
            font-size: 11px;
            font-weight: 620;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            x: 152px;
            y: 0px;
            width: 58px;
            height: 24px;
            text: root.reasoning_label;
            color: #eeeee8bd;
            font-size: 11px;
            font-weight: 620;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Image {
            x: 224px;
            y: 7px;
            width: 9px;
            height: 9px;
            source: @image-url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxNiAxNiIgcHJlc2VydmVBc3BlY3RSYXRpbz0ieE1pZFlNaWQgbWVldCI+PHBhdGggZmlsbD0ibm9uZSIgc3Ryb2tlPSIjRjBGMEVEIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiIHN0cm9rZS13aWR0aD0iMS43IiBkPSJtNCA2bDQgNGw0LTQiLz48L3N2Zz4K");
            image-fit: contain;
            opacity: reasoning-flip-touch.has-hover ? 0.9 : 0.48;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: -90deg + root.llm_reasoning_flip_tick * 360deg;
            animate transform-rotation, opacity { duration: 260ms; easing: ease; }
        }
        reasoning-flip-touch := TouchArea {
            x: 216px;
            y: 0px;
            width: 28px;
            height: parent.height;
            clicked => {
                root.llm_reasoning_index = root.llm_reasoning_index == 2 ? 0 : root.llm_reasoning_index + 1;
                root.llm_reasoning_flip_tick += 1;
                root.cycle_llm_reasoning(1);
            }
        }
    }
    Rectangle {
        visible: root.show_connect_prompt;
        x: parent.width - 184px;
        y: 98px;
        width: 162px;
        height: 24px;
        background: #00000000;
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: root.connect_prompt_label;
            color: connect-provider-touch.has-hover ? (root.llm_connect_prompt_provider == "anthropic" ? #d97757f0 : #eeeee8f0) : (root.llm_connect_prompt_provider == "anthropic" ? #d97757b8 : #eeeee8a8);
            font-size: 10px;
            font-weight: 560;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle { x: parent.width - 96px; y: 20px; width: 96px; height: 1px; background: connect-provider-touch.has-hover ? #eeeee866 : #00000000; }
        connect-provider-touch := TouchArea { clicked => { root.open_llm_providers(root.llm_connect_prompt_provider); } }
    }
}

component NativeModal inherits Rectangle {
    in property <bool> modal_visible;
    in property <string> modal_title;
    in property <string> modal_body;
    callback close_modal();
    visible: root.modal_visible;
    background: #00000088;
    TouchArea { clicked => { root.close_modal(); } }
    Rectangle {
        width: 420px;
        height: 168px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #232322;
        border-color: #353534;
        border-width: 1px;
        border-radius: 6px;
        Text { x: 16px; y: 16px; text: root.modal_title; color: #e8ecee; font-size: 16px; font-weight: 700; }
        Text { x: 16px; y: 48px; width: 388px; text: root.modal_body; color: #9a9a94; font-size: 12px; wrap: word-wrap; }
        Rectangle {
            x: 306px;
            y: 118px;
            width: 96px;
            height: 34px;
            background: #343432;
            border-radius: 4px;
            Text { text: "Close"; color: #e8ecee; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.close_modal(); } }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> proof_status;
    in property <string> gpu_status;
    in property <string> webview_status;
    in property <string> active_section;
    in property <string> section_title;
    in property <string> canvas_title;
