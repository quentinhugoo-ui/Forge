// Native Slint product shell for Migration Front.
// Native Slint shell is the product UI source of truth.
// This file is the native Slint product shell.
import { ScrollView } from "std-widgets.slint";
import "./fonts/Geist-Variable.ttf";
import "./fonts/GeistMono-Variable.ttf";

component NavIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> selected: false;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: selected ? #2f2f2d : #00000000;
    Image {
        x: 7.4px;
        y: 7.4px;
        width: 15.2px;
        height: 15.2px;
        source: root.icon;
        image-fit: contain;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component AutomationIcon inherits Rectangle {
    in property <bool> active: false;
    in property <bool> spinning: false;
    in property <int> tick: 0;
    width: 13.8px;
    height: 13.8px;
    background: #00000000;
    opacity: root.active || root.spinning ? 1.0 : 0.86;
    transform-origin: { x: self.width / 2, y: self.height / 2 };
    transform-rotation: root.spinning ? root.tick * 3.6deg : root.active ? 360deg : 0deg;
    animate transform-rotation, opacity { duration: 420ms; easing: ease; }
    Image {
        width: parent.width;
        height: parent.height;
        source: @image-url("data:image/svg+xml;base64,");
        image-fit: contain;
    }
}

component SidebarAction inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> animated_icon: false;
    in property <bool> eye_visible: false;
    in property <length> icon_size: 14.5px;
    callback clicked();
    callback eye_clicked();
    height: 30px;
    border-radius: 7px;
    background: root.selected ? #eeeeee18 : (touch.pressed ? #ffffff12 : (touch.has-hover ? #ffffff0c : #00000000));
    Image {
        visible: !root.animated_icon;
        x: 20px - root.icon_size / 2;
        y: 15px - root.icon_size / 2;
        width: root.icon_size;
        height: root.icon_size;
        source: root.icon;
        image-fit: contain;
        colorize: #ffffff;
    }
    AutomationIcon {
        visible: root.animated_icon;
        x: 20px - root.icon_size / 2;
        y: 15px - root.icon_size / 2;
        width: root.icon_size;
        height: root.icon_size;
        active: touch.has-hover;
    }
    Text {
        x: 39px;
        y: 0px;
        width: parent.width - (root.eye_visible ? 78px : 52px);
        height: parent.height;
        text: root.label;
        color: root.selected ? #f2f2ee : #e8e8e3;
        font-size: 14px;
        font-weight: 450;
        vertical-alignment: center;
    }
    touch := TouchArea {
        x: 28px;
        y: 0px;
        width: parent.width - 28px;
        height: parent.height;
        clicked => { root.clicked(); }
    }
    Image {
        visible: root.eye_visible;
        x: parent.width - 29px;
        y: 8.5px;
        width: 13px;
        height: 13px;
        source: @image-url("data:image/svg+xml;base64,");
        image-fit: contain;
        opacity: eye_touch.has-hover ? 0.95 : 0.5;
    }
    eye_touch := TouchArea {
        visible: root.eye_visible;
        x: parent.width - 42px;
        y: 0px;
        width: 42px;
        height: parent.height;
        clicked => { root.eye_clicked(); }
    }
    animate y, opacity, background { duration: 180ms; easing: ease; }
}

component ProfileMenuRow inherits Rectangle {
    in property <string> icon_label;
    in property <string> label;
    in property <string> detail;
    callback clicked();
    height: 38px;
    border-radius: 4px;
    background: touch.pressed ? #ffffff14 : (touch.has-hover ? #ffffff0c : #00000000);
    animate background { duration: 140ms; easing: ease; }
    Rectangle {
        x: 10px;
        y: 9px;
        width: 20px;
        height: 20px;
        border-radius: 4px;
        background: #ffffff08;
        border-width: 1px;
        border-color: #ffffff12;
        Text {
            text: root.icon_label;
            color: #eeeee8c8;
            font-size: 8px;
            font-family: "Geist Mono";
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
    Text {
        x: 40px;
        y: 5px;
        width: parent.width - 74px;
        height: 15px;
        text: root.label;
        color: #eeeee8e8;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
    }
    Text {
        x: 40px;
        y: 20px;
        width: parent.width - 74px;
        height: 12px;
        text: root.detail;
        color: #aaa9a480;
        font-size: 9px;
        vertical-alignment: center;
    }
    Image {
        x: parent.width - 22px;
        y: 15px;
        width: 8px;
        height: 8px;
        source: @image-url("data:image/svg+xml;base64,");
        opacity: touch.has-hover ? 0.76 : 0.42;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component DrawerCard inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> open: true;
    in property <length> target-y: 0px;
    in property <bool> selected: false;
    callback clicked();
    x: 8px;
    y: root.open ? root.target-y : root.target-y - 7px;
    width: 247px;
    height: 30px;
    border-radius: 5px;
    background: root.selected ? #eeeeee18 : (touch.pressed ? #eeeeee1a : (touch.has-hover ? #eeeeee12 : #191918ba));
    border-width: 1px;
    border-color: touch.has-hover ? #eeeee824 : #eeeee812;
    opacity: root.open ? 1.0 : 0.0;
    Image {
        x: 10.75px;
        y: 7.75px;
        width: 14.5px;
        height: 14.5px;
        source: root.icon;
        image-fit: contain;
        colorize: #ffffff;
    }
    Text {
        x: 35px;
        y: 0px;
        width: parent.width - 48px;
        height: parent.height;
        text: root.label;
        color: #e1e1dc;
        font-size: 12px;
        font-weight: 400;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    animate y, opacity, background, border-color { duration: 240ms; easing: ease; }
}

component SidebarCanvasDrawer inherits Rectangle {
    in property <string> kind;
    property <bool> open: root.kind != "";
    callback primary();
    callback secondary();
    callback tertiary();
    callback quaternary();
    width: 263px;
    height: !root.open ? 0px : root.kind == "pool" ? 158px : 126px;
    background: #00000000;
    opacity: root.open ? 1.0 : 0.0;
    clip: true;
    animate y, height, opacity { duration: 260ms; easing: ease; }

    Image {
        y: -36px;
        width: parent.width;
        height: 604px;
        source: @image-url("data:image/svg+xml;base64,");
    }

    DrawerCard {
        open: root.open;
        target-y: 12px;
        icon: root.kind == "assets" ? @image-url("data:image/svg+xml;base64,") : root.kind == "modules" ? @image-url("data:image/svg+xml;base64,") : @image-url("data:image/svg+xml;base64,");
        label: root.kind == "assets" ? "Asset Library" : root.kind == "modules" ? "Google modules" : "My Pools";
        clicked => { root.primary(); }
    }
    DrawerCard {
        open: root.open;
        target-y: 46px;
        icon: root.kind == "assets" ? @image-url("data:image/svg+xml;base64,") : root.kind == "modules" ? @image-url("data:image/svg+xml;base64,") : @image-url("data:image/svg+xml;base64,");
        label: root.kind == "assets" ? "Recent Imports" : root.kind == "modules" ? "Banger tools" : "Create Pool";
        clicked => { root.secondary(); }
    }
    DrawerCard {
        open: root.open;
        target-y: 80px;
        icon: root.kind == "assets" ? @image-url("data:image/svg+xml;base64,") : root.kind == "modules" ? @image-url("data:image/svg+xml;base64,") : @image-url("data:image/svg+xml;base64,");
        label: root.kind == "assets" ? "Local Documents" : root.kind == "modules" ? "Trading tools" : "Join Pool";
        clicked => { root.tertiary(); }
    }
    DrawerCard {
        visible: root.kind == "pool";
        open: root.open;
        target-y: 114px;
        icon: @image-url("data:image/svg+xml;base64,");
        label: "Discover Agents";
        clicked => { root.quaternary(); }
    }
}

component WorkMotionIndicator inherits Rectangle {
    in property <image> frame;
    width: 14px;
    height: 14px;
    background: #00000000;
    Image {
        width: parent.width;
        height: parent.height;
        source: root.frame;
        image-fit: contain;
    }
}

component SessionRow inherits Rectangle {
    in property <string> session_id: "";
    in property <string> label;
    in property <string> date: "2026-06-08";
    in property <string> section: "forge";
    in property <bool> selected: false;
    in property <bool> filled: true;
    in property <bool> pinned: false;
    in property <bool> working: false;
    in property <bool> automated: false;
    in property <bool> archived: false;
    in property <image> work_motion_image;
    in-out property <bool> archive_confirm_open: false;
    in-out property <string> archive_candidate_id: "";
    in-out property <string> archive_candidate_label: "";
    in-out property <string> archive_candidate_date: "";
    in-out property <string> archive_candidate_section: "forge";
    callback clicked();
    callback pin_clicked();
    property <length> archive_slide: root.archived ? -286px : 0px;
    height: root.archived ? 0px : 28px;
    opacity: root.archived ? 0.0 : 1.0;
    clip: true;
    border-radius: 6px;
    background: selected ? #eeeeee1a : (touch.has-hover ? #eeeeee10 : #00000000);
    Image {
        visible: !root.automated;
        x: root.archive_slide + 8.25px;
        y: 6.9px;
        width: 14.2px;
        height: 14.2px;
        source: @image-url("data:image/svg+xml;base64,");
        image-fit: contain;
        opacity: root.pinned ? 0.82 : (touch.has-hover ? 0.58 : 0.0);
        pin-touch := TouchArea {
            x: -6px;
            y: -6px;
            width: 26px;
            height: 26px;
            clicked => { root.pin_clicked(); }
        }
    }
    AutomationIcon {
        visible: root.automated;
        x: root.archive_slide + 8.55px;
        y: 7.1px;
        spinning: false;
    }
    Text {
        x: root.archive_slide + 34px;
        y: 0px;
        width: root.working ? parent.width - 88px : parent.width - 64px;
        height: parent.height;
        text: root.label;
        color: selected ? #f0f0ed : #d2d2cc;
        font-size: 13px;
        font-weight: selected ? 560 : 430;
        vertical-alignment: center;
        overflow: elide;
    }
    WorkMotionIndicator {
        visible: root.working && !archive_touch.has-hover;
        x: root.archive_slide + parent.width - 23px;
        y: 7px;
        frame: root.work_motion_image;
    }
    Image {
        x: root.archive_slide + parent.width - 23px;
        y: 7px;
        width: 14px;
        height: 14px;
        source: @image-url("data:image/svg+xml;base64,");
        image-fit: contain;
        colorize: #ffffff;
        opacity: archive_touch.has-hover || touch.has-hover ? 0.72 : 0.0;
        animate opacity { duration: 120ms; easing: ease; }
    }
    archive_touch := TouchArea {
        x: parent.width - 32px;
        y: 0px;
        width: 32px;
        height: root.archived ? 0px : parent.height;
        mouse-cursor: pointer;
        clicked => {
            root.archive_candidate_label = root.label;
            root.archive_candidate_id = root.session_id;
            root.archive_candidate_date = root.date;
            root.archive_candidate_section = root.section;
            root.archive_confirm_open = true;
        }
    }
    touch := TouchArea {
        x: 28px;
        y: 0px;
        width: parent.width - 62px;
        height: parent.height;
        clicked => { root.clicked(); }
    }
    animate height, opacity, archive_slide { duration: 230ms; easing: ease; }
    animate background { duration: 140ms; easing: ease; }
}

component HeaderSessionLine inherits Rectangle {
    in property <string> session_id: "";
    in property <string> label;
    in property <string> date;
    in property <string> section;
    callback selected(string, string);
    height: 30px;
    background: touch.has-hover ? #ffffff0a : #00000000;
    Text {
        x: 0px;
        y: 0px;
        width: parent.width - 96px;
        height: parent.height;
        text: root.label;
        color: touch.has-hover ? #f0f0ed : #d6d6d0;
        font-size: 12px;
        font-weight: 450;
        vertical-alignment: center;
        overflow: elide;
    }
    Text {
        x: parent.width - 88px;
        y: 0px;
        width: 88px;
        height: parent.height;
        text: root.date;
        color: touch.has-hover ? #aaa9a4d0 : #aaa9a482;
        font-size: 10px;
        font-family: "Geist Mono";
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.selected(root.session_id, root.section); }
    }
}

component HeaderSessionsMenu inherits Rectangle {
    in-out property <bool> open: false;
    in-out property <string> mode: "recents";
    in property <string> recent_session_id: "";
    in property <bool> recent_session_visible: false;
    in property <string> recent_session_label: "";
    in property <string> recent_session_date: "";
    in property <string> recent_session_section: "forge";
    in property <string> archived_session_id: "";
    in property <bool> has_archived_session: false;
    in property <string> archived_session_label: "";
    in property <string> archived_session_date: "";
    in property <string> archived_session_section: "forge";
    callback selected(string, string);
    width: 336px;
    height: root.open ? 438px : 0px;
    opacity: root.open ? 1.0 : 0.0;
    background: #00000000;
    clip: true;
    animate height { duration: 145ms; easing: ease; }
    animate opacity { duration: 110ms; easing: ease; }

    Text {
        x: 0px;
        y: 12px;
        width: 64px;
        height: 22px;
        text: "Recents";
        color: root.mode == "recents" ? #eeeee8e8 : #aaa9a486;
        font-size: 11px;
        font-family: "Geist Mono";
        font-weight: root.mode == "recents" ? 750 : 520;
        vertical-alignment: center;
    }
    Text {
        x: 78px;
        y: 12px;
        width: 74px;
        height: 22px;
        text: "Archived";
        color: root.mode == "archived" ? #eeeee8e8 : #aaa9a486;
        font-size: 11px;
        font-family: "Geist Mono";
        font-weight: root.mode == "archived" ? 750 : 520;
        vertical-alignment: center;
    }
    Rectangle { x: root.mode == "recents" ? 0px : 78px; y: 35px; width: root.mode == "recents" ? 42px : 50px; height: 1px; background: #eeeee8c0; animate x, width { duration: 120ms; easing: ease; } }
    TouchArea { x: 0px; y: 8px; width: 62px; height: 30px; mouse-cursor: pointer; clicked => { root.mode = "recents"; } }
    TouchArea { x: 76px; y: 8px; width: 78px; height: 30px; mouse-cursor: pointer; clicked => { root.mode = "archived"; } }

    Rectangle {
        x: 0px;
        y: 50px;
        width: parent.width;
        height: 368px;
        background: #00000000;
        clip: true;
        HeaderSessionLine { visible: root.mode == "recents" && root.recent_session_visible; y: 0px; width: parent.width; session_id: root.recent_session_id; label: root.recent_session_label; date: root.recent_session_date; section: root.recent_session_section; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "recents"; y: 30px; width: parent.width; label: "LLM Act Codes discovery methods"; date: "2026-06-08"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "recents"; y: 60px; width: parent.width; label: "PoolClaw agent profiles"; date: "2026-06-07"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "recents"; y: 90px; width: parent.width; label: "Banger create 3D object"; date: "2026-06-07"; section: "banger"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "recents"; y: 120px; width: parent.width; label: "Google Drive module map"; date: "2026-06-07"; section: "webexplorer"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "recents"; y: 150px; width: parent.width; label: "Trading alert console"; date: "2026-06-06"; section: "trading"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "recents"; y: 180px; width: parent.width; label: "Monster compute proof"; date: "2026-06-06"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "recents"; y: 210px; width: parent.width; label: "My Assets import pass"; date: "2026-06-05"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }

        HeaderSessionLine { visible: root.mode == "archived" && root.has_archived_session; y: 0px; width: parent.width; session_id: root.archived_session_id; label: root.archived_session_label; date: root.archived_session_date; section: root.archived_session_section; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 30px : 0px; width: parent.width; label: "Pool invite flow"; date: "2026-06-05"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 60px : 30px; width: parent.width; label: "Web peripheral snapshot"; date: "2026-06-04"; section: "webexplorer"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 90px : 60px; width: parent.width; label: "Forge UI harmonization"; date: "2026-06-04"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 120px : 90px; width: parent.width; label: "Automation queue sketch"; date: "2026-06-03"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 150px : 120px; width: parent.width; label: "Banger boolean test"; date: "2026-06-03"; section: "banger"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 180px : 150px; width: parent.width; label: "Trading watchlist NATGAS"; date: "2026-06-02"; section: "trading"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 210px : 180px; width: parent.width; label: "Google Docs editor pass"; date: "2026-06-02"; section: "webexplorer"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 240px : 210px; width: parent.width; label: "Frontend language alternatives"; date: "2026-06-01"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 270px : 240px; width: parent.width; label: "Banger section right panel"; date: "2026-06-01"; section: "banger"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 300px : 270px; width: parent.width; label: "Token consumption in sessions"; date: "2026-05-31"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
        HeaderSessionLine { visible: root.mode == "archived"; y: root.has_archived_session ? 330px : 300px; width: parent.width; label: "Chat bar layout redesign"; date: "2026-05-31"; section: "forge"; selected(id, section) => { root.open = false; root.selected(id, section); } }
    }
}

component ScrollGlyph inherits Rectangle {
    in property <float> thumb-y: 0;
    width: 8px;
    background: #232e33;
    border-radius: 3px;
    Rectangle {
        y: root.thumb-y * 1px;
        width: 8px;
        height: 44px;
        border-radius: 3px;
        background: #ffffff;
        border-width: 2px;
        border-color: #000000;
    }
}

component PanelGlyph inherits Rectangle {
    in property <bool> open: true;
    width: 16px;
    height: 16px;
    background: #00000000;
    opacity: root.open ? 0.86 : 0.52;
    animate opacity { duration: 180ms; easing: ease; }
    Image {
        x: 1.35px;
        y: 1.35px;
        width: parent.width - 2.7px;
        height: parent.height - 2.7px;
        source: @image-url("data:image/svg+xml;base64,");
        image-fit: contain;
    }
}

