component GoogleWebViewCanvas inherits Rectangle {
    in property <string> active_section;
    in property <string> native_webexplorer_status;
    in property <string> webview_status;
    in property <image> google_logo_image;
    visible: root.active_section == "webexplorer";
    background: #f7f7f7;

    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 1px;
        background: #d8d8d8;
    }
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 34px;
        background: #ffffff;
        Rectangle {
            x: 14px;
            y: 8px;
            width: parent.width - 28px;
            height: 18px;
            border-radius: 9px;
            background: #f1f3f4;
            Text {
                x: 14px;
                y: 0px;
                width: parent.width - 28px;
                height: parent.height;
                text: root.webview_status;
                color: #5f6368;
                font-size: 10px;
                font-family: "Geist Mono";
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
    Image {
        x: (parent.width - 300px) / 2;
        y: (parent.height - 108px) / 2 + 18px;
        width: 300px;
        height: 108px;
        source: root.google_logo_image;
        image-fit: contain;
        colorize: #8a8d91;
        opacity: 0.72;
    }
}

