component AtlasInspector inherits Rectangle {
    in property <string> active_section;
    in property <string> tree_lines;
    in property <string> selected_summary;
    in property <string> ax_summary;
    in property <string> layout_summary;
    in property <string> resource_lines;
    in property <string> action_candidates;
    in property <string> blind_spot_lines;
    in property <string> proof_summary;
    in property <string> search_summary;
    callback previous_node();
    callback next_node();
    visible: false;
    background: #0e0e0f;

    Rectangle {
        x: 28px;
        y: 18px;
        width: 360px;
        height: parent.height - 116px;
        background: #1c1c1bcc;
        border-width: 1px;
        border-color: #eeeee812;
        border-radius: 5px;
        Text { x: 14px; y: 12px; width: parent.width - 28px; height: 20px; text: "RAM DOM Atlas"; color: #eeeee8f0; font-size: 14px; font-weight: 700; }
        Text {
            x: 14px;
            y: 42px;
            width: parent.width - 28px;
            height: parent.height - 58px;
            text: root.tree_lines;
            color: #d7d7d0;
            font-size: 10px;
            font-family: "Geist Mono";
            wrap: word-wrap;
        }
    }

    Rectangle {
        x: 404px;
        y: 18px;
        width: parent.width - 728px;
        height: 132px;
        background: #1c1c1bcc;
        border-width: 1px;
        border-color: #eeeee812;
