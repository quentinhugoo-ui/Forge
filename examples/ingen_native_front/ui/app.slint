// Native Slint product shell for Migration Front.
// Native Slint shell is the product UI source of truth.
// This file is the native Slint product shell.
import { LineEdit } from "std-widgets.slint";

component NavIcon inherits Rectangle {
    in property <image> icon;
    in property <bool> selected: false;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: 4px;
    background: selected ? #2f2f2d : #00000000;
    Image {
        x: 7px;
        y: 7px;
        width: 16px;
        height: 16px;
        source: root.icon;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component ToolTab inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> selected: false;
    callback clicked();
    height: 30px;
    border-radius: 4px;
    background: selected ? #eeeee81a : #00000000;
    Image {
        x: 8px;
        y: 8px;
        width: 14px;
        height: 14px;
        source: root.icon;
    }
    Text {
        x: 27px;
        y: 0px;
        width: parent.width - 30px;
        height: parent.height;
        text: root.label;
        color: selected ? #f4f4ee : #eeeee894;
        font-size: 12px;
        font-weight: selected ? 700 : 500;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component SidebarAction inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    callback clicked();
    height: 30px;
    background: #00000000;
    Image {
        x: 0px;
        y: 7.5px;
        width: 15px;
        height: 15px;
        source: root.icon;
    }
    Text {
        x: 24px;
        y: 0px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.label;
        color: #deded9;
        font-size: 13px;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component SessionRow inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> filled: true;
    callback clicked();
    height: 34px;
    border-radius: 6px;
    background: selected ? #3a3a38 : #00000000;
    Rectangle {
        x: 12px;
        y: 14px;
        width: 8px;
        height: 8px;
        border-radius: 8px;
        background: filled ? #efc94c : #00000000;
        border-width: filled ? 0px : 1px;
        border-color: #8f8f89;
    }
    Text {
        x: 30px;
        y: 0px;
        width: parent.width - 54px;
        height: parent.height;
        text: root.label;
        color: selected ? #f0f0ed : #d2d2cc;
        font-size: 14px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Text {
        x: parent.width - 26px;
        y: 0px;
        width: 18px;
        height: parent.height;
        text: ":";
        color: #aaa9a4;
        font-size: 16px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    TouchArea { clicked => { root.clicked(); } }
}

component ScrollGlyph inherits Rectangle {
    in property <float> thumb-y: 0;
    width: 3px;
    background: #ffffff0f;
    border-radius: 999px;
    Rectangle {
        y: root.thumb-y * 1px;
        width: 3px;
        height: 44px;
        border-radius: 999px;
        background: #d2d2ce80;
    }
}

component TitleBar inherits Rectangle {
    in property <string> active_section;
    callback navigate(string);
    callback close();
    callback minimize();
    callback maximize();
    height: 38px;
    background: #0e0e0f;

    NavIcon { x: 6px; y: 4px; icon: @image-url("generated_assets/svg_0000.svg"); selected: root.active_section == "forge" || root.active_section == "shell" || root.active_section == "alpha"; clicked => { root.navigate("forge"); } }
    NavIcon { x: 40px; y: 4px; icon: @image-url("generated_assets/svg_0001.svg"); selected: root.active_section == "webexplorer"; clicked => { root.navigate("webexplorer"); } }
    NavIcon { x: 72px; y: 4px; icon: @image-url("generated_assets/svg_0002.svg"); selected: false; clicked => { root.navigate("forge"); } }
    NavIcon { x: 104px; y: 4px; icon: @image-url("generated_assets/svg_0003.svg"); selected: root.active_section == "banger"; clicked => { root.navigate("banger"); } }
    Text {
        x: 173px;
        y: 0px;
        width: 160px;
        height: parent.height;
        text: root.active_section == "webexplorer" ? "Atlas" : root.active_section == "banger" ? "Banger" : root.active_section == "trading" ? "Trading" : root.active_section == "real-estate" ? "Real Estate" : "Forge";
        color: #e9e9e6;
        font-size: 13px;
        vertical-alignment: center;
    }

    NavIcon { x: parent.width - 176px; y: 4px; icon: @image-url("generated_assets/svg_0004.svg"); selected: root.active_section == "real-estate"; clicked => { root.navigate("real-estate"); } }
    Rectangle {
        x: parent.width - 138px;
        y: 0px;
        width: 46px;
        height: parent.height;
        background: #00000000;
        Text { text: "-"; color: #dcdcd8; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.minimize(); } }
    }
    Rectangle {
        x: parent.width - 92px;
        y: 0px;
        width: 46px;
        height: parent.height;
        background: #00000000;
        Text { text: "[]"; color: #dcdcd8; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.maximize(); } }
    }
    Rectangle {
        x: parent.width - 46px;
        y: 0px;
        width: 46px;
        height: parent.height;
        background: #00000000;
        Text { text: "x"; color: #dcdcd8; font-size: 14px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.close(); } }
    }
}

component LeftPanel inherits Rectangle {
    in property <string> active_section;
    callback navigate(string);
    callback activate_control(string);
    width: 279px;
    background: #1c1c1b;
    border-width: 1px;
    border-color: #373735;
    border-radius: 4px;

    Rectangle {
        x: 22px;
        y: 25px;
        width: 247px;
        height: 40px;
        border-radius: 6px;
        border-width: 1px;
        border-color: #eeeee80f;
        background: #eeeee808;
        ToolTab { x: 5px; y: 5px; width: 77px; icon: @image-url("generated_assets/svg_0008.svg"); label: "Compute"; selected: root.active_section == "forge" || root.active_section == "shell" || root.active_section == "alpha"; clicked => { root.navigate("forge"); } }
        ToolTab { x: 87px; y: 5px; width: 74px; icon: @image-url("generated_assets/svg_0009.svg"); label: "Atlas"; selected: root.active_section == "webexplorer"; clicked => { root.navigate("webexplorer"); } }
        ToolTab { x: 166px; y: 5px; width: 52px; icon: @image-url("generated_assets/svg_0010.svg"); label: "Pool"; selected: root.active_section == "banger"; clicked => { root.navigate("banger"); } }
        Rectangle {
            x: 222px;
            y: 14px;
            width: 28px;
            height: 13px;
            border-radius: 2px;
            background: #eeeee80d;
            Text { text: "soon"; color: #eeeee86b; font-size: 8px; horizontal-alignment: center; vertical-alignment: center; }
        }
    }

    SidebarAction { x: 27px; y: 102px; width: 230px; icon: @image-url("generated_assets/svg_0011.svg"); label: "New session"; clicked => { root.navigate("forge"); } }
    SidebarAction { x: 27px; y: 134px; width: 230px; icon: @image-url("generated_assets/svg_0012.svg"); label: "Documents"; clicked => { root.navigate("forge"); } }
    SidebarAction { x: 27px; y: 166px; width: 230px; icon: @image-url("generated_assets/svg_0013.svg"); label: "My programs"; clicked => { root.navigate("forge"); } }

    Text { x: 17px; y: 226px; width: 240px; height: 22px; text: root.active_section == "trading" ? "Pinned assets" : root.active_section == "webexplorer" ? "Pinned web" : "Pinned"; color: #aaa9a4; font-size: 13px; vertical-alignment: center; }
    Image { x: 27px; y: 259px; width: 15px; height: 15px; source: @image-url("generated_assets/svg_0014.svg"); }
    Text { x: 53px; y: 252px; width: 190px; height: 30px; text: root.active_section == "trading" ? "Pinned markets" : root.active_section == "real-estate" ? "Nouvelle session immo" : "New session"; color: #9d9c96; font-size: 14px; vertical-alignment: center; }

    Text { x: 17px; y: 306px; width: 240px; height: 22px; text: "Recents"; color: #d6d6d2; font-size: 13px; vertical-alignment: center; }
    SessionRow { x: 14px; y: 336px; width: 253px; selected: true; filled: root.active_section == "trading"; label: root.active_section == "trading" ? "NATGAS_USD" : root.active_section == "webexplorer" ? "Web atlas session" : root.active_section == "banger" ? "Banger viewport" : root.active_section == "real-estate" ? "Nouvelle session immo" : "New session"; clicked => { root.navigate(root.active_section); } }
    SessionRow { x: 14px; y: 374px; width: 253px; filled: true; label: root.active_section == "trading" ? "BTC_USD" : root.active_section == "webexplorer" ? "RAM DOM Atlas" : root.active_section == "banger" ? "Conception objet 3D" : root.active_section == "real-estate" ? "Scoring zone" : "Conception objet 3D"; clicked => { root.navigate(root.active_section); } }
    SessionRow { x: 14px; y: 412px; width: 253px; filled: true; label: root.active_section == "trading" ? "EUR_USD" : root.active_section == "webexplorer" ? "Research capture" : root.active_section == "banger" ? "Hey gemini" : root.active_section == "real-estate" ? "Alertes marché" : "Hey gemini"; clicked => { root.navigate(root.active_section); } }
    Rectangle { x: 27px; y: 102px; width: 230px; height: 30px; background: #00000000; TouchArea { clicked => { root.activate_control("New session"); } } }
    Rectangle { x: 27px; y: 134px; width: 230px; height: 30px; background: #00000000; TouchArea { clicked => { root.activate_control("Documents"); } } }
    Rectangle { x: 27px; y: 166px; width: 230px; height: 30px; background: #00000000; TouchArea { clicked => { root.activate_control("My programs"); } } }
    Rectangle { x: 14px; y: 336px; width: 253px; height: 34px; background: #00000000; TouchArea { clicked => { root.activate_control("selected session"); } } }
    Rectangle { x: 14px; y: 374px; width: 253px; height: 34px; background: #00000000; TouchArea { clicked => { root.activate_control("recent session"); } } }
    Rectangle { x: 14px; y: 412px; width: 253px; height: 34px; background: #00000000; TouchArea { clicked => { root.activate_control("recent session"); } } }
    Rectangle {
        visible: root.active_section == "forge" || root.active_section == "shell";
        x: 14px;
        y: 374px;
        width: 253px;
        height: 78px;
        background: #1c1c1b;
    }
    ScrollGlyph { x: 263px; y: 322px; height: 170px; thumb-y: 54; }

    Rectangle {
        x: 20px;
        y: parent.height - 122px;
        width: 239px;
        height: 54px;
        background: #00000000;
        border-width: 1px;
        border-color: #eeeee80f;
        Text { x: 0px; y: 11px; width: 34px; height: 16px; text: "CPU"; color: #eeeee86b; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        Text { x: 50px; y: 9px; width: 170px; height: 20px; text: "detection failed"; color: #eeeee8bd; font-size: 12px; font-weight: 500; vertical-alignment: center; }
        Text { x: 0px; y: 31px; width: 34px; height: 16px; text: "GPU"; color: #eeeee86b; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        Text { x: 50px; y: 29px; width: 170px; height: 20px; text: "No GPU detected"; color: #eeeee8bd; font-size: 12px; font-weight: 500; vertical-alignment: center; }
    }
    Rectangle {
        x: 16px;
        y: parent.height - 48px;
        width: 250px;
        height: 30px;
        background: #00000000;
        Rectangle {
            x: 0px;
            y: 5px;
            width: 20px;
            height: 20px;
            border-radius: 20px;
            background: #efc94c;
            Text { text: "Q"; color: #1c1c1a; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { x: 29px; y: 0px; width: 190px; height: 30px; text: "Quentin"; color: #eeeee8bd; font-size: 12px; font-weight: 600; vertical-alignment: center; }
        Image { x: 234px; y: 10px; width: 10px; height: 10px; source: @image-url("generated_assets/svg_0015.svg"); }
    }
}

component WorkspaceHeader inherits Rectangle {
    in property <string> active_section;
    in property <string> section_title;
    callback navigate(string);
    height: 52px;
    background: #0e0e0f;
    Image { x: 24px; y: 15px; width: 18px; height: 18px; source: @image-url("generated_assets/svg_0016.svg"); }
    Text { x: 74px; y: 0px; width: 130px; height: parent.height; text: root.active_section == "trading" ? "PAPERTRADING" : root.active_section == "real-estate" ? "Forge" : "Choose workspace"; color: #b4b4af80; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    Text { x: 204px; y: 0px; width: 20px; height: parent.height; text: "/"; color: #eeeee857; font-size: 15px; vertical-alignment: center; }
    Text { x: 230px; y: 0px; width: 280px; height: parent.height; text: root.section_title; color: root.active_section == "trading" ? #68d0c4f5 : #eeeee894; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    NavIcon { x: parent.width - 128px; y: 10px; icon: @image-url("generated_assets/svg_0017.svg"); clicked => { root.navigate("forge"); } }
    NavIcon { x: parent.width - 84px; y: 10px; icon: @image-url("generated_assets/svg_0018.svg"); clicked => { root.navigate("webexplorer"); } }
    NavIcon { x: parent.width - 40px; y: 10px; icon: @image-url("generated_assets/svg_0019.svg"); clicked => { root.navigate("real-estate"); } }
}

component DropCanvas inherits Rectangle {
    in property <string> active_section;
    in property <string> canvas_title;
    in property <string> canvas_hint;
    callback activate_control(string);
    background: #0e0e0f;
    Rectangle { x: 328px; y: 86px; width: 22px; height: 22px; background: #00000000; border-width: 1px; border-color: #eeeee857; }
    Rectangle { x: 898px; y: 86px; width: 22px; height: 22px; background: #00000000; border-width: 1px; border-color: #eeeee857; }
    Rectangle { x: 328px; y: 416px; width: 22px; height: 22px; background: #00000000; border-width: 1px; border-color: #eeeee857; }
    Rectangle { x: 898px; y: 416px; width: 22px; height: 22px; background: #00000000; border-width: 1px; border-color: #eeeee857; }
    Image { x: 592px; y: 178px; width: 64px; height: 64px; source: @image-url("generated_assets/svg_0020.svg"); }
    Text { x: 468px; y: 260px; width: 314px; height: 32px; text: root.canvas_title; color: #eeeee8f5; font-size: 19px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    Text {
        x: 394px;
        y: 296px;
        width: 460px;
        height: 44px;
        text: root.canvas_hint;
        color: #eeeee885;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
        wrap: word-wrap;
    }
    Rectangle {
        x: 356px;
        y: 352px;
        width: 536px;
        height: 44px;
        visible: root.active_section != "shell" && root.active_section != "forge";
        background: #00000000;
        Rectangle {
            x: 0px;
            y: 0px;
            width: 126px;
            height: 34px;
            border-radius: 4px;
            background: #eeeee80d;
            border-width: 1px;
            border-color: #eeeee812;
            Text { text: root.active_section == "webexplorer" ? "Open atlas" : root.active_section == "banger" ? "Frame proof" : root.active_section == "trading" ? "Market proof" : root.active_section == "real-estate" ? "Zone proof" : "New compute"; color: #eeeee8d8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.activate_control("primary section action"); } }
        }
        Rectangle {
            x: 136px;
            y: 0px;
            width: 126px;
            height: 34px;
            border-radius: 4px;
            background: #eeeee80d;
            border-width: 1px;
            border-color: #eeeee812;
            Text { text: root.active_section == "webexplorer" ? "Focus web" : root.active_section == "banger" ? "Viewport" : root.active_section == "trading" ? "Backtest" : root.active_section == "real-estate" ? "Resolver" : "Proofs"; color: #eeeee8d8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.activate_control("secondary section action"); } }
        }
        Rectangle {
            x: 272px;
            y: 0px;
            width: 126px;
            height: 34px;
            border-radius: 4px;
            background: #eeeee80d;
            border-width: 1px;
            border-color: #eeeee812;
            Text { text: root.active_section == "webexplorer" ? "Safe action" : root.active_section == "banger" ? "Scene graph" : root.active_section == "trading" ? "Alerts" : root.active_section == "real-estate" ? "Scoring" : "Memory"; color: #eeeee8d8; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.activate_control("tertiary section action"); } }
        }
        Rectangle {
            x: 408px;
            y: 0px;
            width: 126px;
            height: 34px;
            border-radius: 4px;
            background: #d9775722;
            border-width: 1px;
            border-color: #d9775750;
            Text { text: "Promote"; color: #f0d2c6; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.activate_control("promotion gate"); } }
        }
    }
    ScrollGlyph { x: parent.width - 22px; y: 68px; height: 112px; thumb-y: 0; }
}

component StatusLine inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 42px;
    background: #00000000;
    Text {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 14px;
        text: root.label;
        color: #eeeee86b;
        font-size: 10px;
        font-weight: 700;
    }
    Text {
        x: 0px;
        y: 17px;
        width: parent.width;
        height: 22px;
        text: root.value;
        color: #eeeee8c4;
        font-size: 11px;
        wrap: word-wrap;
    }
}

component SectionStatusDock inherits Rectangle {
    in property <string> active_section;
    in property <string> proof_status;
    in property <string> gpu_status;
    in property <string> webview_status;
    in property <string> hardware_status;
    in property <string> provider_status;
    in property <string> job_status;
    in property <string> proof_badge_status;
    in property <string> brain_status;
    in property <string> monster_status;
    in property <string> native_webexplorer_status;
    in property <string> banger_status;
    in property <string> trading_status;
    in property <string> real_estate_status;
    callback refresh();
    callback activate_control(string);

    width: 282px;
    height: 316px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #eeeee812;
    background: #1c1c1bcc;
    visible: root.active_section != "shell" && root.active_section != "forge";

    Text {
        x: 14px;
        y: 12px;
        width: 190px;
        height: 24px;
        text: root.active_section == "webexplorer" ? "Web peripheral" : root.active_section == "banger" ? "Banger viewport" : root.active_section == "trading" ? "Market service" : root.active_section == "real-estate" ? "Real estate service" : "Native service";
        color: #eeeee8f0;
        font-size: 14px;
        font-weight: 700;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 86px;
        y: 10px;
        width: 72px;
        height: 26px;
        border-radius: 4px;
        background: #eeeee80d;
        border-width: 1px;
        border-color: #eeeee812;
        Text { text: "Refresh"; color: #eeeee8d8; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
        TouchArea { clicked => { root.refresh(); } }
    }

    StatusLine {
        x: 14px;
        y: 52px;
        width: parent.width - 28px;
        label: "PRIMARY";
        value: root.active_section == "webexplorer" ? root.native_webexplorer_status : root.active_section == "banger" ? root.banger_status : root.active_section == "trading" ? root.trading_status : root.active_section == "real-estate" ? root.real_estate_status : root.brain_status;
    }
    StatusLine {
        x: 14px;
        y: 102px;
        width: parent.width - 28px;
        label: root.active_section == "webexplorer" ? "WEBVIEW" : root.active_section == "banger" ? "GPU" : "PROVIDER";
        value: root.active_section == "webexplorer" ? root.webview_status : root.active_section == "banger" ? root.gpu_status : root.provider_status;
    }
    StatusLine {
        x: 14px;
        y: 152px;
        width: parent.width - 28px;
        label: "JOBS";
        value: root.job_status;
    }
    StatusLine {
        x: 14px;
        y: 202px;
        width: parent.width - 28px;
        label: "PROOF";
        value: root.proof_badge_status;
    }
    Rectangle {
        x: 14px;
        y: 263px;
        width: parent.width - 28px;
        height: 34px;
        border-radius: 4px;
        background: #2a2a28;
        border-width: 1px;
        border-color: #eeeee812;
        Text { x: 12px; y: 0px; width: parent.width - 24px; height: parent.height; text: "Open native details"; color: #eeeee8d8; font-size: 12px; vertical-alignment: center; }
        TouchArea { clicked => { root.activate_control("Native section details"); } }
    }
}

component BangerNativeViewport inherits Rectangle {
    in property <string> active_section;
    in property <image> frame_image;
    in property <string> frame_hash;
    in property <string> bridge_hash;
    callback activate_control(string);
    visible: root.active_section == "banger";
    background: #0e0e0f;

    Rectangle {
        x: 28px;
        y: 18px;
        width: parent.width - 356px;
        height: parent.height - 182px;
        background: #090909;
        border-width: 1px;
        border-color: #eeeee812;
        border-radius: 4px;
        Image {
            x: 14px;
            y: 14px;
            width: parent.width - 28px;
            height: parent.height - 28px;
            source: root.frame_image;
            image-fit: contain;
        }
        Text {
            x: 18px;
            y: parent.height - 34px;
            width: parent.width - 36px;
            height: 18px;
            text: "native Banger viewport";
            color: #eeeee89e;
            font-size: 11px;
        }
    }

    Rectangle {
        x: 44px;
        y: parent.height - 142px;
        width: parent.width - 388px;
        height: 72px;
        background: #1c1c1bcc;
        border-width: 1px;
        border-color: #eeeee812;
        border-radius: 5px;
        Text {
            x: 14px;
            y: 10px;
            width: parent.width - 28px;
            height: 18px;
            text: "frame " + root.frame_hash;
            color: #31c8b2;
            font-size: 10px;
        }
        Text {
            x: 14px;
            y: 36px;
            width: parent.width - 28px;
            height: 18px;
            text: "slint bridge " + root.bridge_hash;
            color: #eeeee894;
            font-size: 10px;
