component TradingHeaderIcon inherits Rectangle {
    in property <bool> selected: false;
    callback clicked();
    width: 44px;
    height: 38px;
    background: #00000000;
    Image {
        visible: !root.selected;
        x: 15.35px;
        y: 12.35px;
        width: 13.3px;
        height: 13.3px;
        source: @image-url("data:image/svg+xml;base64,");
        image-fit: contain;
        colorize: #eeeee8a0;
    }
    Image {
        visible: root.selected;
        x: 15.35px;
        y: 12.35px;
        width: 13.3px;
        height: 13.3px;
        source: @image-url("data:image/svg+xml;base64,");
        image-fit: contain;
        colorize: #30d158;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component WindowControl inherits Rectangle {
    in property <string> kind;
    in property <bool> mac_chrome: false;
    in property <bool> danger: false;
    callback clicked();
    width: 46px;
    height: 38px;
    background: root.mac_chrome ? #00000000 : (touch.has-hover ? (root.danger ? #c42b1c : #ffffff12) : #00000000);
    animate background { duration: 120ms; easing: ease; }
    Rectangle {
        visible: root.mac_chrome;
        x: 17px;
        y: 13px;
        width: 12px;
        height: 12px;
        border-radius: 999px;
        background: root.kind == "close" ? #ff5f57 : root.kind == "min" ? #ffbd2e : #28c840;
        border-width: 1px;
        border-color: #00000055;
    }
    Rectangle {
        visible: !root.mac_chrome && root.kind == "min";
        x: 18px;
        y: 19px;
        width: 10px;
        height: 2px;
        border-radius: 2px;
        background: #eeeee8c8;
    }
    Rectangle {
        visible: !root.mac_chrome && root.kind == "max";
        x: 18px;
        y: 14px;
        width: 10px;
        height: 10px;
        border-radius: 2px;
        border-width: 1px;
        border-color: #eeeee8c8;
        background: #00000000;
    }
    Text {
        visible: !root.mac_chrome && root.kind == "close";
        width: parent.width;
        height: parent.height;
        text: "x";
        color: #eeeee8dd;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        width: parent.width;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component HardwarePill inherits Rectangle {
    in property <string> cpu_label;
    in property <string> gpu_label;
    width: 212px;
    height: 22px;
    border-radius: 6px;
    background: #eeeeee0a;
    border-width: 1px;
    border-color: #eeeee812;
    Text { x: 9px; y: 0px; width: 24px; height: parent.height; text: "CPU"; color: #eeeee86f; font-size: 9px; font-weight: 650; vertical-alignment: center; }
    Text { x: 35px; y: 0px; width: 54px; height: parent.height; text: root.cpu_label; color: #eeeee8b2; font-size: 9px; font-family: "Geist Mono"; vertical-alignment: center; overflow: elide; }
    Rectangle { x: 95px; y: 6px; width: 1px; height: 10px; background: #eeeee81f; }
    Text { x: 104px; y: 0px; width: 24px; height: parent.height; text: "GPU"; color: #eeeee86f; font-size: 9px; font-weight: 650; vertical-alignment: center; }
    Text { x: 132px; y: 0px; width: 70px; height: parent.height; text: root.gpu_label; color: #eeeee8b2; font-size: 9px; font-family: "Geist Mono"; vertical-alignment: center; overflow: elide; }
}

component TitleBar inherits Rectangle {
    in property <bool> left_panel_open;
    in property <bool> mac_chrome;
    in property <string> active_section;
    in property <string> cpu_label;
    in property <string> gpu_label;
    in-out property <bool> sessions_menu_open: false;
    in-out property <string> sessions_menu_mode: "recents";
    in property <string> recent_session_id: "";
    in property <bool> recent_session_visible: false;
    in property <string> recent_session_label: "";
    in property <string> recent_session_date: "";
    in property <string> recent_session_section: "forge";
    in property <string> archived_session_id: "";
    in property <bool> has_archived_session: false;
    in property <string> archived_session_label: "";
    in property <string> archived_session_date: "";
    in property <string> archived_session_section: "forge";
    callback toggle_left_panel();
    callback open_session(string, string);
    callback open_google_webview();
    callback open_banger_section();
    callback open_trading_section();
    callback minimize();
    callback maximize();
    callback close();
    height: 38px;
    background: #00000000;

    TouchArea {
        x: root.mac_chrome ? 318px : 178px;
        y: 0px;
        width: max(0px, parent.width - (root.mac_chrome ? 318px : 316px));
        height: parent.height;
        mouse-cursor: grab;
        double-clicked => { root.maximize(); }
    }

    Rectangle {
        x: root.mac_chrome ? 140px : 2px;
        y: 0px;
        width: 44px;
        height: 38px;
        background: #00000000;
        PanelGlyph {
            x: 14px;
            y: 11px;
            width: 16px;
            height: 16px;
            open: root.left_panel_open;
        }
        toggle := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.toggle_left_panel(); }
        }
    }

    Rectangle {
        x: root.mac_chrome ? 184px : 46px;
        y: 0px;
        width: 44px;
        height: 38px;
        background: #00000000;
        Image {
            x: 15.35px;
            y: 12.35px;
            width: 13.3px;
            height: 13.3px;
            source: @image-url("data:image/svg+xml;base64,");
            image-fit: contain;
            opacity: search_touch.has-hover || root.sessions_menu_open ? 0.92 : 0.62;
        }
        search_touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.sessions_menu_open = !root.sessions_menu_open; }
        }
    }

    HeaderSessionsMenu {
        x: root.mac_chrome ? 188px : 50px;
        y: 34px;
        open <=> root.sessions_menu_open;
        mode <=> root.sessions_menu_mode;
        recent_session_id: root.recent_session_id;
        recent_session_visible: root.recent_session_visible;
        recent_session_label: root.recent_session_label;
        recent_session_date: root.recent_session_date;
        recent_session_section: root.recent_session_section;
        archived_session_id: root.archived_session_id;
        has_archived_session: root.has_archived_session;
        archived_session_label: root.archived_session_label;
        archived_session_date: root.archived_session_date;
        archived_session_section: root.archived_session_section;
        selected(id, section) => { root.open_session(id, section); }
    }

    GoogleHeaderIcon {
        x: root.mac_chrome ? 228px : 90px;
        selected: root.active_section == "webexplorer";
        clicked => { root.open_google_webview(); }
    }

    BangerHeaderIcon {
        x: root.mac_chrome ? 272px : 134px;
        selected: root.active_section == "banger";
        clicked => { root.open_banger_section(); }
    }

    TradingHeaderIcon {
        x: root.mac_chrome ? 316px : 178px;
        selected: root.active_section == "trading";
        clicked => { root.open_trading_section(); }
    }

    HardwarePill {
        x: root.mac_chrome ? root.width - 226px : root.width - 364px;
        y: 8px;
        cpu_label: root.cpu_label;
        gpu_label: root.gpu_label;
    }

    WindowControl { x: root.mac_chrome ? 2px : root.width - 138px; kind: root.mac_chrome ? "close" : "min"; mac_chrome: root.mac_chrome; danger: root.mac_chrome; clicked => { root.mac_chrome ? root.close() : root.minimize(); } }
    WindowControl { x: root.mac_chrome ? 48px : root.width - 92px; kind: root.mac_chrome ? "min" : "max"; mac_chrome: root.mac_chrome; clicked => { root.mac_chrome ? root.minimize() : root.maximize(); } }
    WindowControl { x: root.mac_chrome ? 94px : root.width - 46px; kind: root.mac_chrome ? "max" : "close"; mac_chrome: root.mac_chrome; danger: !root.mac_chrome; clicked => { root.mac_chrome ? root.maximize() : root.close(); } }
}

component LeftPanel inherits Rectangle {
    in property <string> active_section;
    in property <string> cpu_label;
    in property <string> gpu_label;
    in property <image> work_motion_image;
    in-out property <string> active_drawer: "";
    in-out property <bool> profile_open: false;
    in-out property <bool> assets_hidden: false;
    in-out property <bool> automations_hidden: false;
    in-out property <bool> brain_hidden: false;
    in-out property <bool> hidden_tools_open: false;
    in-out property <string> pinned_session_label: "Web atlas session";
    in-out property <string> pinned_session_section: "webexplorer";
    in-out property <bool> pinned_session_working: false;
    in-out property <bool> pinned_session_automated: false;
    in property <string> recent_session_id: "";
    in property <bool> recent_session_visible: false;
    in property <string> recent_session_label: "";
    in property <string> recent_session_date: "";
    in property <string> recent_session_section: "forge";
    in property <string> archived_session_id: "";
    in-out property <bool> has_archived_session: false;
    in-out property <string> archived_session_label: "";
    in-out property <string> archived_session_date: "";
    in-out property <string> archived_session_section: "forge";
    in-out property <bool> archive_confirm_open: false;
    in-out property <string> archive_candidate_id: "";
    in-out property <string> archive_candidate_label: "";
    in-out property <string> archive_candidate_date: "";
    in-out property <string> archive_candidate_section: "forge";
    property <length> pool_drawer_offset: root.active_drawer == "pool" ? 162px : 0px;
    property <length> assets_drawer_offset: root.active_drawer == "assets" && !root.assets_hidden ? 130px : 0px;
    property <length> modules_drawer_offset: root.active_drawer == "modules" ? 130px : 0px;
    property <length> after_pool_offset: root.pool_drawer_offset;
    property <length> after_assets_offset: root.pool_drawer_offset + root.assets_drawer_offset;
    property <length> lower_offset: root.pool_drawer_offset + root.assets_drawer_offset + root.modules_drawer_offset;
    property <length> assets_hidden_shift: root.assets_hidden ? -34px : 0px;
    property <length> automations_hidden_shift: root.automations_hidden ? -34px : 0px;
    property <length> brain_hidden_shift: root.brain_hidden ? -34px : 0px;
    property <length> visible_tools_shift: root.assets_hidden_shift + root.automations_hidden_shift + root.brain_hidden_shift;
    property <int> hidden_tools_count: (root.assets_hidden ? 1 : 0) + (root.automations_hidden ? 1 : 0) + (root.brain_hidden ? 1 : 0);
    property <bool> has_hidden_tools: root.hidden_tools_count > 0;
    property <length> hidden_tools_height: !root.has_hidden_tools ? 0px : (root.hidden_tools_open ? 20px + root.hidden_tools_count * 30px : 20px);
    property <length> profile_menu_height: root.profile_open ? 108px : 0px;
    animate pool_drawer_offset, assets_drawer_offset, modules_drawer_offset, assets_hidden_shift, automations_hidden_shift, brain_hidden_shift, hidden_tools_height { duration: 260ms; easing: ease; }
    animate profile_menu_height { duration: 145ms; easing: ease; }
    callback navigate(string);
    callback open_session(string, string);
    callback activate_control(string);
    callback open_profile_canvas(string);
    callback archive_session(string);
    width: 279px;
    background: #1c1c1b;
    border-width: 1px;
    border-color: #373735;
    border-radius: 4px;

    SidebarAction { x: 14px; y: 18px; width: 251px; icon: @image-url("data:image/svg+xml;base64,"); icon_size: 16px; label: "New Session"; selected: root.active_section == "forge" && root.active_drawer == ""; clicked => { root.navigate("forge"); } }
    SidebarAction { x: 14px; y: 51px; width: 251px; icon: @image-url("data:image/svg+xml;base64,"); label: "Pool"; selected: root.active_drawer == "pool"; clicked => { root.active_drawer = root.active_drawer == "pool" ? "" : "pool"; } }
    SidebarCanvasDrawer {
        x: 14px;
        y: root.active_drawer == "pool" ? 84px : 78px;
        kind: root.active_drawer == "pool" ? "pool" : "";
        primary => { root.activate_control("My Pools"); }
        secondary => { root.activate_control("Create Pool"); }
        tertiary => { root.activate_control("Join Pool"); }
        quaternary => { root.activate_control("Discover Agents"); }
    }
    SidebarAction { x: 14px; y: 86px + root.after_pool_offset; width: 251px; icon: @image-url("data:image/svg+xml;base64,"); label: "Modules"; selected: root.active_drawer == "modules"; clicked => { root.active_drawer = root.active_drawer == "modules" ? "" : "modules"; } }
    SidebarCanvasDrawer {
        x: 14px;
        y: 118px + root.after_pool_offset + (root.active_drawer == "modules" ? 0px : -6px);
        kind: root.active_drawer == "modules" ? "modules" : "";
        primary => { root.activate_control("Google modules"); }
        secondary => { root.activate_control("Banger tools"); }
        tertiary => { root.activate_control("Trading tools"); }
    }
    SidebarAction {
        visible: !root.assets_hidden;
        opacity: root.assets_hidden ? 0.0 : 1.0;
        x: 14px;
        y: 120px + root.after_pool_offset + root.modules_drawer_offset;
        width: 251px;
        icon: @image-url("data:image/svg+xml;base64,");
        label: "My Assets";
        selected: root.active_drawer == "assets";
        eye_visible: true;
        clicked => { root.active_drawer = root.active_drawer == "assets" ? "" : "assets"; }
        eye_clicked => { root.assets_hidden = true; root.active_drawer = root.active_drawer == "assets" ? "" : root.active_drawer; root.hidden_tools_open = false; }
    }
    SidebarCanvasDrawer {
        x: 14px;
        y: 152px + root.after_pool_offset + root.modules_drawer_offset + (root.active_drawer == "assets" && !root.assets_hidden ? 0px : -6px);
        kind: root.active_drawer == "assets" && !root.assets_hidden ? "assets" : "";
        primary => { root.activate_control("Asset Library"); }
        secondary => { root.activate_control("Recent Imports"); }
        tertiary => { root.activate_control("Local Documents"); }
    }
    SidebarAction {
        visible: !root.automations_hidden;
        opacity: root.automations_hidden ? 0.0 : 1.0;
        x: 14px;
        y: 154px + root.after_pool_offset + root.modules_drawer_offset + root.assets_drawer_offset + root.assets_hidden_shift;
        width: 251px;
        icon_size: 16px;
        label: "Automations";
        animated_icon: true;
        eye_visible: true;
        clicked => { root.activate_control("Automations"); }
        eye_clicked => { root.automations_hidden = true; root.hidden_tools_open = false; }
    }
    SidebarAction {
        visible: !root.brain_hidden;
        opacity: root.brain_hidden ? 0.0 : 1.0;
        x: 14px;
        y: 188px + root.after_pool_offset + root.modules_drawer_offset + root.assets_drawer_offset + root.assets_hidden_shift + root.automations_hidden_shift;
        width: 251px;
        icon: @image-url("data:image/svg+xml;base64,");
        icon_size: 16px;
        label: "Brain";
        eye_visible: true;
        clicked => { root.open_profile_canvas("brain"); }
        eye_clicked => { root.brain_hidden = true; root.hidden_tools_open = false; }
    }

    Rectangle {
        visible: root.has_hidden_tools;
        x: 14px;
        y: 244px + root.lower_offset + root.visible_tools_shift;
        width: 251px;
        height: root.hidden_tools_height;
        clip: true;
        background: #00000000;
        opacity: root.has_hidden_tools ? 1.0 : 0.0;
        animate y, height, opacity { duration: 260ms; easing: ease; }
        Image {
            x: 8px;
            y: 5px;
            width: 10px;
            height: 10px;
            source: @image-url("data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHZpZXdCb3g9IjAgMCAxNiAxNiIgcHJlc2VydmVBc3BlY3RSYXRpbz0ieE1pZFlNaWQgbWVldCI+PHBhdGggZmlsbD0ibm9uZSIgc3Ryb2tlPSIjRjBGMEVEIiBzdHJva2UtbGluZWNhcD0icm91bmQiIHN0cm9rZS1saW5lam9pbj0icm91bmQiIHN0cm9rZS13aWR0aD0iMS43IiBkPSJtNCA2bDQgNGw0LTQiLz48L3N2Zz4K");
            image-fit: contain;
            opacity: hidden_header_touch.has-hover ? 0.95 : 0.58;
            transform-origin: { x: self.width / 2, y: self.height / 2 };
            transform-rotation: root.hidden_tools_open ? 180deg : 0deg;
            animate opacity, transform-rotation { duration: 180ms; easing: ease; }
        }
        hidden_header_touch := TouchArea {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: 20px;
            clicked => { root.hidden_tools_open = !root.hidden_tools_open; }
        }
        SidebarAction {
            visible: root.hidden_tools_open && root.assets_hidden;
            x: 0px;
            y: 20px;
            width: 251px;
            icon: @image-url("data:image/svg+xml;base64,");
            label: "My Assets";
            clicked => { root.assets_hidden = false; root.hidden_tools_open = root.automations_hidden || root.brain_hidden; }
        }
        SidebarAction {
            visible: root.hidden_tools_open && root.automations_hidden;
            x: 0px;
            y: 20px + (root.assets_hidden ? 30px : 0px);
            width: 251px;
            icon_size: 16px;
            label: "Automations";
            animated_icon: true;
            clicked => { root.automations_hidden = false; root.hidden_tools_open = root.assets_hidden || root.brain_hidden; }
        }
        SidebarAction {
            visible: root.hidden_tools_open && root.brain_hidden;
            x: 0px;
            y: 20px + (root.assets_hidden ? 30px : 0px) + (root.automations_hidden ? 30px : 0px);
            width: 251px;
            icon: @image-url("data:image/svg+xml;base64,");
            icon_size: 16px;
            label: "Brain";
            clicked => { root.brain_hidden = false; root.hidden_tools_open = root.assets_hidden || root.automations_hidden; }
        }
    }

    Rectangle {
        x: 14px;
        y: 244px + root.lower_offset + root.visible_tools_shift + root.hidden_tools_height;
        width: 265px;
        height: max(180px, parent.height - root.lower_offset - root.visible_tools_shift - root.hidden_tools_height - 286px);
        background: #00000000;
        clip: true;
        animate y, height { duration: 260ms; easing: ease; }

        Image {
            y: 31px;
            width: parent.width;
            height: 604px;
            source: @image-url("data:image/svg+xml;base64,");
        }

        Rectangle { x: 0px; y: 0px; width: 265px; height: 31px; background: #1c1c1b; }
        Text { x: 8px; y: 0px; width: 219px; height: 24px; text: "Recents"; color: #d6d6d2; font-size: 12px; font-weight: 500; vertical-alignment: center; }
        ScrollView {
            x: 0px;
            y: 31px;
            width: 265px;
            height: max(60px, parent.height - 31px);
            viewport-width: 253px;
            viewport-height: 604px;
            SessionRow { visible: root.recent_session_visible; x: 0px; y: 0px; width: 253px; session_id: root.recent_session_id; selected: root.recent_session_section == root.active_section; filled: true; label: root.recent_session_label; date: root.recent_session_date; section: root.recent_session_section; pinned: true; working: root.pinned_session_working; automated: root.pinned_session_automated; archived: root.has_archived_session && root.archived_session_id == root.recent_session_id; work_motion_image: root.work_motion_image; archive_confirm_open <=> root.archive_confirm_open; archive_candidate_id <=> root.archive_candidate_id; archive_candidate_label <=> root.archive_candidate_label; archive_candidate_date <=> root.archive_candidate_date; archive_candidate_section <=> root.archive_candidate_section; clicked => { root.open_session(root.recent_session_id, root.recent_session_section); } pin_clicked => { root.activate_control("pinned session already first"); } }
            SessionRow { x: 0px; y: 30px; width: 253px; session_id: "demo-working-session"; filled: true; label: "Demo agent working now"; date: "2026-06-08"; section: root.active_section; archived: root.has_archived_session && root.archived_session_id == "demo-working-session"; working: true; automated: false; work_motion_image: root.work_motion_image; archive_confirm_open <=> root.archive_confirm_open; archive_candidate_id <=> root.archive_candidate_id; archive_candidate_label <=> root.archive_candidate_label; archive_candidate_date <=> root.archive_candidate_date; archive_candidate_section <=> root.archive_candidate_section; clicked => { root.navigate(root.active_section); } pin_clicked => { root.pinned_session_label = "Demo agent working now"; root.pinned_session_section = root.active_section; root.pinned_session_working = true; root.pinned_session_automated = false; root.activate_control("pin session"); } }
            SessionRow { x: 0px; y: 60px; width: 253px; filled: true; label: "PoolClaw agent profiles"; date: "2026-06-07"; section: root.active_section; archived: root.has_archived_session && root.archived_session_label == "PoolClaw agent profiles"; archive_confirm_open <=> root.archive_confirm_open; archive_candidate_label <=> root.archive_candidate_label; archive_candidate_date <=> root.archive_candidate_date; archive_candidate_section <=> root.archive_candidate_section; clicked => { root.navigate(root.active_section); } pin_clicked => { root.pinned_session_label = "PoolClaw agent profiles"; root.pinned_session_section = root.active_section; root.pinned_session_working = false; root.pinned_session_automated = false; root.activate_control("pin session"); } }
            SessionRow { x: 0px; y: 90px; width: 253px; filled: true; label: "Banger create 3D object"; date: "2026-06-07"; section: "banger"; archived: root.has_archived_session && root.archived_session_label == "Banger create 3D object"; archive_confirm_open <=> root.archive_confirm_open; archive_candidate_label <=> root.archive_candidate_label; archive_candidate_date <=> root.archive_candidate_date; archive_candidate_section <=> root.archive_candidate_section; clicked => { root.navigate("banger"); } pin_clicked => { root.pinned_session_label = "Banger create 3D object"; root.pinned_session_section = "banger"; root.pinned_session_working = false; root.pinned_session_automated = false; root.activate_control("pin session"); } }
