component NativeModal inherits Rectangle {
    in property <bool> modal_visible;
    in property <string> modal_title;
    in property <string> modal_body;
    callback close_modal();
    visible: root.modal_visible;
    background: #00000088;
    TouchArea { clicked => { root.close_modal(); } }
    Rectangle {
        width: 420px;
        height: 168px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: #232322;
        border-color: #353534;
        border-width: 1px;
        border-radius: 6px;
        Text { x: 16px; y: 16px; text: root.modal_title; color: #e8ecee; font-size: 16px; font-weight: 700; }
        Text { x: 16px; y: 48px; width: 388px; text: root.modal_body; color: #9a9a94; font-size: 12px; wrap: word-wrap; }
        Rectangle {
            x: 306px;
            y: 118px;
            width: 96px;
            height: 34px;
            background: #343432;
            border-radius: 4px;
            Text { text: "Close"; color: #e8ecee; font-size: 13px; horizontal-alignment: center; vertical-alignment: center; }
            TouchArea { clicked => { root.close_modal(); } }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> proof_status;
    in property <string> gpu_status;
    in property <string> webview_status;
    in property <string> active_section;
    in property <string> section_title;
    in property <string> canvas_title;
    in property <string> canvas_hint;
    in property <string> session_lines;
    in property <string> transcript_lines;
    in property <string> plan_cards;
    in property <string> questionnaire_cards;
    in property <string> proof_cards;
    in property <string> agent_surface_status;
    in property <string> product_section_title;
    in property <string> product_section_status;
    in property <string> product_section_metrics;
    in property <string> product_section_cards;
    in property <string> product_section_actions;
    in property <string> product_section_proof;
    in property <string> hardware_status;
    in property <string> provider_status;
    in property <string> job_status;
    in property <string> proof_badge_status;
    in property <string> brain_status;
    in property <string> monster_status;
    in property <string> panel_status;
    in property <string> native_webexplorer_status;
    in property <string> banger_status;
    in property <string> trading_status;
    in property <string> real_estate_status;
    in property <image> banger_frame_image;
    in property <string> banger_frame_hash;
    in property <string> banger_bridge_hash;
    in property <string> atlas_tree_lines;
    in property <string> atlas_selected_summary;
    in property <string> atlas_ax_summary;
    in property <string> atlas_layout_summary;
    in property <string> atlas_resource_lines;
    in property <string> atlas_action_candidates;
    in property <string> atlas_blind_spot_lines;
    in property <string> atlas_proof_summary;
    in property <string> atlas_search_summary;
    in property <bool> modal_visible;
    in property <string> modal_title;
    in property <string> modal_body;
    in-out property <string> chat_text;
    callback refresh_probes();
    callback navigate(string);
    callback activate_imported_control(string);
    callback window_close();
    callback window_minimize();
    callback window_toggle_maximize();
    callback navigate_next();
    callback send_chat();
    callback close_modal();
    callback atlas_previous_node();
    callback atlas_next_node();

    title: "InGen Native Front - Forge";
    no-frame: true;
    preferred-width: 1535px;
    preferred-height: 786px;
    min-width: 1180px;
    min-height: 760px;
    background: #0e0e0f;

    FocusScope {
        KeyBinding { keys: @keys(Control+Tab); activated => { root.navigate_next(); } }
        KeyBinding { keys: @keys(Escape); activated => { root.close_modal(); } }
    }

    Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: #0e0e0f; }
    TitleBar {
        width: parent.width;
        active_section: root.active_section;
        navigate(section) => { root.navigate(section); }
        close => { root.window_close(); }
        minimize => { root.window_minimize(); }
        maximize => { root.window_toggle_maximize(); }
    }
    LeftPanel {
        x: 8px;
        y: 44px;
        height: root.height - 54px;
        active_section: root.active_section;
        navigate(section) => { root.navigate(section); }
        activate_control(label) => { root.activate_imported_control(label); }
    }
    WorkspaceHeader {
        x: 287px;
        y: 44px;
        width: root.width - 287px;
        active_section: root.active_section;
        section_title: root.section_title;
        navigate(section) => { root.navigate(section); }
    }
    DropCanvas {
        x: 287px;
        y: 96px;
        width: root.width - 287px;
        height: root.height - 96px;
        active_section: root.active_section;
        canvas_title: root.canvas_title;
        canvas_hint: root.canvas_hint;
        activate_control(label) => { root.activate_imported_control(label); }
    }
    BangerNativeViewport {
        x: 287px;
        y: 96px;
        width: root.width - 287px;
        height: root.height - 96px;
        active_section: root.active_section;
        frame_image: root.banger_frame_image;
        frame_hash: root.banger_frame_hash;
        bridge_hash: root.banger_bridge_hash;
        activate_control(label) => { root.activate_imported_control(label); }
    }
    AtlasInspector {
        x: 287px;
        y: 96px;
        width: root.width - 287px;
        height: root.height - 96px;
        active_section: root.active_section;
        tree_lines: root.atlas_tree_lines;
        selected_summary: root.atlas_selected_summary;
        ax_summary: root.atlas_ax_summary;
        layout_summary: root.atlas_layout_summary;
        resource_lines: root.atlas_resource_lines;
        action_candidates: root.atlas_action_candidates;
        blind_spot_lines: root.atlas_blind_spot_lines;
        proof_summary: root.atlas_proof_summary;
        search_summary: root.atlas_search_summary;
        previous_node => { root.atlas_previous_node(); }
        next_node => { root.atlas_next_node(); }
    }
    AgentSurface {
        x: 287px;
        y: 96px;
        width: root.width - 287px;
        height: root.height - 96px;
        active_section: root.active_section;
        session_lines: root.session_lines;
        transcript_lines: root.transcript_lines;
        plan_cards: root.plan_cards;
        questionnaire_cards: root.questionnaire_cards;
        proof_cards: root.proof_cards;
        agent_surface_status: root.agent_surface_status;
    }
    ProductSectionSurface {
        x: 287px;
        y: 96px;
        width: root.width - 287px;
        height: root.height - 96px;
        active_section: root.active_section;
        title: root.product_section_title;
        status: root.product_section_status;
        metric_lines: root.product_section_metrics;
        card_lines: root.product_section_cards;
        action_lines: root.product_section_actions;
        proof_summary: root.product_section_proof;
        activate_control(label) => { root.activate_imported_control(label); }
    }
    SectionStatusDock {
        x: root.width - 314px;
        y: 112px;
        active_section: root.active_section;
        proof_status: root.proof_status;
        gpu_status: root.gpu_status;
        webview_status: root.webview_status;
        hardware_status: root.hardware_status;
        provider_status: root.provider_status;
        job_status: root.job_status;
        proof_badge_status: root.proof_badge_status;
        brain_status: root.brain_status;
        monster_status: root.monster_status;
        native_webexplorer_status: root.native_webexplorer_status;
        banger_status: root.banger_status;
        trading_status: root.trading_status;
        real_estate_status: root.real_estate_status;
        refresh => { root.refresh_probes(); }
        activate_control(label) => { root.activate_imported_control(label); }
    }
    ChatBar {
        x: (root.width - 780px) / 2 + 143px;
        y: root.height - 156px;
        chat_text <=> root.chat_text;
        attach_file => { root.activate_imported_control("Attach file"); }
        send => { root.send_chat(); }
    }
    NativeModal {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        modal_visible: root.modal_visible;
        modal_title: root.modal_title;
        modal_body: root.modal_body;
        close_modal => { root.close_modal(); }
    }
}
