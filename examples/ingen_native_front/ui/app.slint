    Rectangle {
        visible: root.archive_confirm_open;
        z: 20;
        x: 26px;
        y: 266px + root.lower_offset + root.visible_tools_shift + root.hidden_tools_height;
        width: 226px;
        height: 108px;
        border-radius: 6px;
        background: #20201ef4;
        border-width: 1px;
        border-color: #eeeee824;
        opacity: root.archive_confirm_open ? 1.0 : 0.0;
        animate opacity, y { duration: 150ms; easing: ease; }
        Text {
            x: 12px;
            y: 10px;
            width: parent.width - 24px;
            height: 18px;
            text: "Archive this session?";
            color: #eeeee8;
            font-size: 12px;
            font-weight: 700;
            vertical-alignment: center;
        }
        Text {
            x: 12px;
            y: 32px;
            width: parent.width - 24px;
            height: 28px;
            text: root.archive_candidate_label;
            color: #aaa9a4;
            font-size: 10px;
            wrap: word-wrap;
        }
        Rectangle {
            x: 12px;
            y: 68px;
            width: 82px;
            height: 26px;
            border-radius: 4px;
            background: cancel_archive_touch.has-hover ? #ffffff0d : #00000000;
            Text { text: "Cancel"; color: #cfcfca; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
            cancel_archive_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.archive_confirm_open = false; }
            }
        }
        Rectangle {
            x: parent.width - 106px;
            y: 68px;
            width: 94px;
            height: 26px;
            border-radius: 4px;
            background: confirm_archive_touch.has-hover ? #ffffff13 : #ffffff08;
            border-width: 1px;
            border-color: #ffffff18;
            Text { text: "Yes, archive"; color: #eeeee8; font-size: 11px; font-weight: 650; horizontal-alignment: center; vertical-alignment: center; }
            confirm_archive_touch := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.has_archived_session = true;
                    root.archived_session_label = root.archive_candidate_label;
                    root.archived_session_date = root.archive_candidate_date;
                    root.archived_session_section = root.archive_candidate_section;
                    root.archive_session(root.archive_candidate_id);
                    root.archive_confirm_open = false;
                }
            }
        }
    }

    Rectangle {
        x: 14px;
        y: parent.height - 32px - root.profile_menu_height;
        width: 251px;
        height: root.profile_menu_height + 24px;
        clip: true;
        border-radius: 6px;
        background: root.profile_open ? #222220f4 : #00000000;
        border-width: root.profile_open ? 1px : 0px;
        border-color: root.profile_open ? #eeeee81a : #eeeee800;
        animate y, height, background, border-color { duration: 145ms; easing: ease; }
    }
    Rectangle {
        x: 14px;
        y: parent.height - 32px - root.profile_menu_height;
        width: 251px;
        height: root.profile_menu_height;
        clip: true;
        border-radius: 6px;
        background: #00000000;
        border-width: 0px;
        border-color: #00000000;
        opacity: root.profile_open ? 1.0 : 0.0;
        animate y, height { duration: 145ms; easing: ease; }
        animate opacity, border-color { duration: 115ms; easing: ease; }
        Text { x: 12px; y: 8px; width: 220px; height: 18px; text: "@Quentin"; color: #eeeee8d8; font-size: 11px; font-family: "Geist Mono"; font-weight: 650; vertical-alignment: center; }
        Rectangle { x: 10px; y: 31px; width: parent.width - 20px; height: 1px; background: #eeeee812; }
        ProfileMenuRow {
            x: 6px;
            y: 38px;
            width: parent.width - 12px;
            icon_label: "AI";
            label: "LLM providers";
            detail: "Keys, models and local routing";
            clicked => { root.profile_open = false; root.open_profile_canvas("llm"); }
        }
        ProfileMenuRow {
            x: 6px;
            y: 76px;
            width: parent.width - 12px;
            icon_label: "Q";
            label: "Profile";
            detail: "Public canvas replica";
            clicked => { root.profile_open = false; root.open_profile_canvas("profile"); }
        }
    }
    Rectangle {
        x: 14px;
        y: parent.height - 32px;
        width: 251px;
        height: 24px;
        border-radius: 6px;
        background: root.profile_open ? #00000000 : (profile_touch.has-hover ? #eeeeee0c : #00000000);
        animate background { duration: 140ms; easing: ease; }
        Rectangle {
            x: 8px;
            y: 4px;
            width: 16px;
            height: 16px;
            border-radius: 16px;
            background: #efc94c;
            Text { text: "Q"; color: #1c1c1a; font-size: 8px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
        }
        Text { x: 34px; y: 0px; width: 180px; height: parent.height; text: "Quentin"; color: #eeeee8b8; font-size: 11px; font-weight: 560; vertical-alignment: center; }
        Image { x: 235px; y: 8px; width: 8px; height: 8px; source: @image-url("data:image/svg+xml;base64,"); opacity: 0.58; }
        profile_touch := TouchArea {
            width: parent.width;
            height: parent.height;
            mouse-cursor: pointer;
            clicked => { root.profile_open = !root.profile_open; }
        }
    }
}

component ProfileMiniStat inherits Rectangle {
    in property <string> value;
    in property <string> label;
    width: 112px;
    height: 24px;
    background: #00000000;
    Text { x: 0px; y: 0px; width: 34px; height: 20px; text: root.value; color: #eeeee8f0; font-size: 13px; font-family: "Geist Mono"; font-weight: 650; vertical-alignment: center; }
    Text { x: 38px; y: 1px; width: parent.width - 38px; height: 18px; text: root.label; color: #aaa9a486; font-size: 10px; vertical-alignment: center; }
}

component ProfileProjectTile inherits Rectangle {
    in property <string> title;
    in property <string> kind;
    in property <color> accent;
    height: 146px;
    border-radius: 6px;
    background: #111111;
    border-width: 1px;
    border-color: #ffffff10;
    Rectangle {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: 106px;
        border-radius: 5px;
        background: #0a0a0a;
        Rectangle { x: 18px; y: 18px; width: parent.width - 36px; height: 16px; border-radius: 3px; background: #ffffff08; }
        Rectangle { x: 18px; y: 44px; width: parent.width - 86px; height: 12px; border-radius: 3px; background: #ffffff0d; }
        Rectangle { x: 18px; y: 66px; width: parent.width - 54px; height: 10px; border-radius: 3px; background: #ffffff08; }
        Rectangle { x: parent.width - 52px; y: 18px; width: 20px; height: 20px; border-radius: 4px; background: root.accent; opacity: 0.72; }
    }
    Rectangle { x: 0px; y: 106px; width: parent.width; height: 1px; background: #ffffff10; }
    Text { x: 12px; y: 115px; width: 54px; height: 18px; text: root.kind; color: #aaa9a486; font-size: 10px; font-family: "Geist Mono"; vertical-alignment: center; }
    Text { x: 70px; y: 115px; width: parent.width - 86px; height: 18px; text: root.title; color: #d9d9d4; font-size: 11px; font-family: "Geist Mono"; vertical-alignment: center; }
}

component PoolClawProfileSurface inherits Rectangle {
    in property <string> mode;
    in property <image> banner_image;
    in property <image> avatar_image;
    in property <bool> avatar_ready: false;
    callback attach_avatar();
    visible: root.mode == "profile";
    background: #0e0e0f;
    property <length> content_width: min(960px, root.width - 72px);
    property <length> inner_width: root.content_width - 40px;
    property <length> right_width: min(360px, root.inner_width * 2 / 5);
    property <length> left_width: root.inner_width - root.right_width - 10px;

    ScrollView {
        x: (parent.width - root.content_width) / 2;
        y: 24px;
        width: root.content_width;
        height: parent.height - 24px;
        viewport-width: root.content_width;
        viewport-height: 905px;

        Rectangle {
            x: 0px;
            y: 0px;
            width: root.content_width;
            height: 905px;
            background: #00000000;

            Rectangle {
                x: 0px;
                y: 0px;
                width: root.content_width;
                height: 120px;
                border-radius: 6px;
                background: #120d0d;
                border-width: 1px;
                border-color: #c0392b2e;
                clip: true;
                Image {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    source: root.banner_image;
                    image-fit: cover;
                }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: parent.height; background: #05050536; }
                Rectangle { x: 48px; y: 28px; width: root.content_width - 96px; height: 1px; background: #c0392b34; }
                Rectangle { x: 88px; y: 58px; width: root.content_width - 176px; height: 1px; background: #ffffff12; }
                Rectangle { x: 138px; y: 88px; width: root.content_width - 276px; height: 1px; background: #c0392b24; }
            }

            Rectangle {
                x: 28px;
                y: 84px;
                width: 96px;
                height: 96px;
                border-radius: 48px;
                background: #1e1e1e;
                border-width: 3px;
                border-color: #090909;
                clip: true;
                Image {
                    visible: root.avatar_ready;
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: parent.height;
                    source: root.avatar_image;
                    image-fit: cover;
                }
                Text { visible: !root.avatar_ready; text: "QH"; color: #eeeee8; font-size: 22px; font-family: "Geist Mono"; font-weight: 750; horizontal-alignment: center; vertical-alignment: center; }
                Rectangle { x: 0px; y: 0px; width: parent.width; height: 1px; background: avatar_touch.has-hover ? #ffffff32 : #ffffff12; }
                Rectangle { x: 0px; y: parent.height - 1px; width: parent.width; height: 1px; background: #00000070; }
                avatar_touch := TouchArea {
                    width: parent.width;
                    height: parent.height;
                    mouse-cursor: pointer;
                    clicked => { root.attach_avatar(); }
                }
            }

            Rectangle {
                x: 144px;
                y: 94px;
                width: root.content_width - 172px;
                height: 126px;
                background: #00000000;
                Text { x: 0px; y: 0px; width: 148px; height: 26px; text: "@Quentin"; color: #eeeee8; font-size: 20px; font-family: "Geist Mono"; font-weight: 760; vertical-alignment: center; }
                Rectangle { x: 158px; y: 7px; width: 8px; height: 8px; border-radius: 8px; background: #555555; }
                Text { x: 172px; y: 1px; width: 168px; height: 24px; text: "Offline"; color: #aaa9a486; font-size: 11px; vertical-alignment: center; }
                Text { x: 0px; y: 32px; width: parent.width; height: 18px; text: "Paris, France / OpenClaw / Member since June 2026 / // MY HUMAN / @ quentin@ingen.local"; color: #aaa9a486; font-size: 11px; vertical-alignment: center; }
                ProfileMiniStat { x: 0px; y: 58px; value: "128"; label: "connections"; }
                Rectangle { x: 112px; y: 63px; width: 1px; height: 14px; background: #ffffff18; }
                ProfileMiniStat { x: 126px; y: 58px; value: "42"; label: "completed pools"; }
                Rectangle { x: 238px; y: 63px; width: 1px; height: 14px; background: #ffffff18; }
                ProfileMiniStat { x: 252px; y: 58px; value: "7"; label: "IP shares"; }
                Text {
                    x: 0px;
                    y: 90px;
                    width: min(620px, parent.width);
                    height: 36px;
                    text: "Compact local agent OS builder. CodeAct templates, Monster proofs, native UI migration and verified reusable compute circuits.";
                    color: #b8b8b2;
                    font-size: 12px;
                    wrap: word-wrap;
                    vertical-alignment: top;
                }
            }

            Rectangle {
                x: 20px;
                y: 232px;
                width: root.left_width;
                height: 446px;
                background: #00000000;
                Text { x: 0px; y: 0px; width: parent.width; height: 18px; text: "// Projects"; color: #aaa9a486; font-size: 10px; font-family: "Geist Mono"; font-weight: 700; vertical-alignment: center; }
                Rectangle { x: parent.width - 88px; y: 0px; width: 88px; height: 24px; border-radius: 4px; background: #ffffff08; border-width: 1px; border-color: #ffffff12; Text { text: "Node View"; color: #d6d6d2; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; } }
                ProfileProjectTile { x: 0px; y: 40px; width: parent.width; title: "Forge native profile canvas"; kind: "repo"; accent: #c0392b; }
                ProfileProjectTile { x: 0px; y: 198px; width: parent.width; title: "Monster compute proof atlas"; kind: "proof"; accent: #68d0c4; }
            }

            Rectangle {
                x: 30px + root.left_width;
                y: 232px;
                width: root.right_width;
                height: 172px;
                background: #00000000;
                Text { x: 0px; y: 0px; width: parent.width; height: 18px; text: "// Specialty"; color: #aaa9a486; font-size: 10px; font-family: "Geist Mono"; font-weight: 700; vertical-alignment: center; }
                Rectangle { x: 0px; y: 38px; width: parent.width; height: 112px; border-radius: 6px; background: #141418; border-width: 1px; border-color: #ffffff14; }
                Text { x: 16px; y: 52px; width: parent.width - 32px; height: 24px; text: "Agentic OS / verified compute"; color: #eeeee8; font-size: 14px; font-weight: 650; vertical-alignment: center; }
                Text { x: 16px; y: 82px; width: parent.width - 32px; height: 48px; text: "Godel verification, Forge bytecode, Monster execution and local native projection."; color: #aaa9a4; font-size: 11px; wrap: word-wrap; }
            }

            Rectangle {
                x: 30px + root.left_width;
                y: 424px;
                width: root.right_width;
                height: 196px;
                background: #00000000;
                Text { x: 0px; y: 0px; width: parent.width; height: 18px; text: "// Pool Activity"; color: #aaa9a486; font-size: 10px; font-family: "Geist Mono"; font-weight: 700; vertical-alignment: center; }
                Rectangle { x: 0px; y: 38px; width: parent.width; height: 58px; border-radius: 6px; background: #141418; border-width: 1px; border-color: #ffffff12; Text { x: 14px; y: 10px; width: parent.width - 28px; height: 18px; text: "Native front cutover"; color: #dcdcd8; font-size: 12px; font-weight: 620; } Text { x: 14px; y: 30px; width: parent.width - 28px; height: 16px; text: "autonomous / proof ready"; color: #aaa9a486; font-size: 10px; font-family: "Geist Mono"; } }
                Rectangle { x: 0px; y: 106px; width: parent.width; height: 58px; border-radius: 6px; background: #141418; border-width: 1px; border-color: #c0392b88; Text { x: 14px; y: 10px; width: parent.width - 28px; height: 18px; text: "PoolClaw profile replica"; color: #c0392b; font-size: 12px; font-weight: 620; } Text { x: 14px; y: 30px; width: parent.width - 28px; height: 16px; text: "bento page / canvas route"; color: #c0392ba0; font-size: 10px; font-family: "Geist Mono"; } }
            }

            Rectangle {
                x: 20px;
                y: 704px;
                width: root.inner_width;
                height: 138px;
                background: #00000000;
                Text { x: 0px; y: 0px; width: parent.width; height: 18px; text: "// Skills & Endorsements"; color: #aaa9a486; font-size: 10px; font-family: "Geist Mono"; font-weight: 700; vertical-alignment: center; }
                Rectangle { x: 0px; y: 38px; width: 132px; height: 36px; border-radius: 4px; background: #ffffff08; border-width: 1px; border-color: #ffffff12; Text { text: "Forge"; color: #eeeee8d8; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { x: 146px; y: 38px; width: 132px; height: 36px; border-radius: 4px; background: #ffffff08; border-width: 1px; border-color: #ffffff12; Text { text: "Monster"; color: #eeeee8d8; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { x: 292px; y: 38px; width: 132px; height: 36px; border-radius: 4px; background: #ffffff08; border-width: 1px; border-color: #ffffff12; Text { text: "Slint"; color: #eeeee8d8; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
                Rectangle { x: 438px; y: 38px; width: 164px; height: 36px; border-radius: 4px; background: #c0392b18; border-width: 1px; border-color: #c0392b40; Text { text: "Verified compute"; color: #efb0a9; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; } }
            }
        }
    }
}

component LlmProviderListRow inherits Rectangle {
    in property <string> provider_id;
    in property <string> selected_provider;
    in property <string> name;
    in property <string> route;
    in property <bool> connected: false;
    callback selected(string);
    property <bool> is_sel: root.selected_provider == root.provider_id;
    height: 48px;
    background: touch.has-hover && !root.is_sel ? #ffffff06 : #00000000;
    animate background { duration: 140ms; easing: ease; }
    // Barre accent gauche â€” 2px turquoise quand sÃ©lectionnÃ©
    Rectangle {
        x: 0px; y: 13px;
        width: 2px; height: parent.height - 26px;
        border-radius: 1px;
        background: root.is_sel ? #67e8d4 : #00000000;
        animate background { duration: 200ms; easing: ease; }
    }
    // Nom du provider
    Text {
        x: 16px; y: 9px;
        width: parent.width - 36px; height: 18px;
        text: root.name;
        color: root.is_sel ? #ffffff : (touch.has-hover ? #eeeee8e0 : #eeeee8a8);
        font-family: "Geist Mono";
        font-size: 13px;
        font-weight: root.is_sel ? 700 : 450;
        vertical-alignment: center;
        animate color { duration: 140ms; easing: ease; }
    }
    // MÃ©thode d'auth
    Text {
        x: 16px; y: 27px;
        width: parent.width - 36px; height: 14px;
        text: root.route;
        color: root.is_sel ? #67e8d455 : #48474380;
        font-family: "Geist Mono";
        font-size: 10px;
        vertical-alignment: center;
        animate color { duration: 140ms; easing: ease; }
    }
    // Dot connexion
    Rectangle {
        x: parent.width - 16px; y: (parent.height - 6px) / 2;
        width: 6px; height: 6px; border-radius: 3px;
        background: root.connected ? #67e8d4 : #323230;
        animate background { duration: 400ms; easing: ease; }
    }
    touch := TouchArea {
        width: parent.width; height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.selected(root.provider_id); }
    }
}

component TerminalEventLine inherits Rectangle {
    in property <string> text;
    in property <bool> active: true;
    in property <bool> keyword: false;
    height: 22px;
    visible: root.active;
    Text {
        x: 0px; y: 0px; width: 14px; height: parent.height;
        text: ">";
        color: #67e8d4aa;
        font-family: "Geist Mono";
        font-size: 11px;
        vertical-alignment: center;
    }
    Text {
        x: 16px; y: 0px; width: parent.width - 16px; height: parent.height;
        text: root.text;
        color: root.keyword ? #67e8d4 : #eeeee8b8;
        font-family: "Geist Mono";
        font-size: 11px;
        vertical-alignment: center;
    }
}

component CliNoticeBox inherits Rectangle {
    in property <string> text;
    border-radius: 4px;
    border-width: 1px;
    border-color: #67e8d42e;
    background: #67e8d406;
    Rectangle { x: 0px; y: 0px; width: 2px; height: parent.height; background: #67e8d44a; }
    Text {
        x: 16px; y: 0px;
        width: parent.width - 30px; height: parent.height;
        text: root.text;
        color: #d6d6cf;
        font-family: "Geist Mono";
        font-size: 11px;
        wrap: word-wrap;
        vertical-alignment: center;
    }
}

component CliStatusCol inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <bool> accent: false;
    Text { x: 0px; y: 0px; width: parent.width; height: 14px; text: root.label; color: #55554f; font-family: "Geist Mono"; font-size: 10px; vertical-alignment: center; }
    Text { x: 0px; y: 15px; width: parent.width; height: 16px; text: root.value; color: root.accent ? #67e8d4 : #cbcbc4; font-family: "Geist Mono"; font-size: 11px; vertical-alignment: center; }
}

component LlmProvidersSurface inherits Rectangle {
    in property <string> mode;
    in-out property <string> selected_provider;
    in-out property <bool> openai_connected: false;
    in-out property <bool> anthropic_connected: false;
    in-out property <bool> openrouter_connected: false;
    callback connect_provider(string);
    visible: root.mode == "llm";
    background: #0e0e0f;
    property <length> content_width: min(1040px, root.width - 96px);
    property <bool> selected_connected: root.selected_provider == "openai" ? root.openai_connected : root.selected_provider == "anthropic" ? root.anthropic_connected : root.openrouter_connected;
    property <string> terminal_title: root.selected_provider == "openai" ? "CODEX" : root.selected_provider == "anthropic" ? "CLAUDE" : "OPENROUTER";
    property <string> terminal_name: root.selected_provider == "openai" ? "OpenAI" : root.selected_provider == "anthropic" ? "Anthropic" : "OpenRouter";
    property <string> terminal_method: root.selected_provider == "openai" ? "Web OAuth through ChatGPT Codex. The app uses the ChatGPT subscription grant, not a local CLI token path." : root.selected_provider == "anthropic" ? "CLI authentication through Claude Code. The app reads the installed CLI session." : "OAuth PKCE. The callback exchanges the code for a user-scoped OpenRouter key.";
    property <string> terminal_cmd: root.selected_provider == "openai" ? "open ChatGPT Codex OAuth" : root.selected_provider == "anthropic" ? "claude auth login" : "openrouter OAuth PKCE";
    property <bool> cursor_on: Math.mod(Math.floor(animation-tick() / 540ms), 2) == 0;
    property <string> terminal_cli: root.selected_provider == "openai" ? "Codex Web" : root.selected_provider == "anthropic" ? "Claude Code" : "OpenRouter OAuth";
    property <string> terminal_version: root.selected_provider == "openai" ? "ChatGPT" : root.selected_provider == "anthropic" ? "v2.0.21" : "PKCE";
    property <string> terminal_signin: root.selected_provider == "openai" ? "Sign in with ChatGPT" : root.selected_provider == "anthropic" ? "Authenticate via Claude Code" : "OAuth PKCE sign-in";
    property <string> terminal_plan: root.selected_provider == "openai" ? "Plan: ChatGPT subscription Â· Codex web grant" : root.selected_provider == "anthropic" ? "Plan: Claude Code CLI session" : "Plan: user-scoped OpenRouter key";
    property <image> terminal_mark: root.selected_provider == "openai" ? @image-url("data:image/svg+xml;base64,") : root.selected_provider == "anthropic" ? @image-url("data:image/svg+xml;base64,") : @image-url("data:image/svg+xml;base64,");
    property <string> terminal_models: root.selected_provider == "openai" ? "Codex Web catalog from ChatGPT subscription grant" : root.selected_provider == "anthropic" ? "Claude Code catalog from installed session" : "OpenRouter catalog from /api/v1/models";
    property <string> terminal_model_1: root.selected_provider == "openai" ? "codex / gpt-5.3 / gpt-5.2-codex" : root.selected_provider == "anthropic" ? "opus-4.8 / sonnet-4.6 / haiku-4.5" : "auto route / frontier route / fast route";
    property <string> terminal_model_2: root.selected_provider == "openai" ? "plus any Codex web models returned by the subscription grant" : root.selected_provider == "anthropic" ? "plus every model alias exposed by claude models" : "plus every model returned by OpenRouter OAuth";
    property <length> chat_clearance: 184px;
    Rectangle {
        x: (parent.width - root.content_width) / 2;
        y: 36px;
        width: root.content_width;
        height: max(430px, parent.height - root.chat_clearance - 36px);
        background: #00000000;

        Rectangle {
            x: 0px;
            y: 0px;
            width: 286px;
            height: parent.height;
            background: #00000000;
            // Header section label
            Text { x: 0px; y: 6px; width: parent.width; height: 16px; text: "PROVIDERS"; color: #3c3c39; font-family: "Geist Mono"; font-size: 10px; font-weight: 700; vertical-alignment: center; }
            Rectangle { x: 0px; y: 28px; width: parent.width; height: 1px; background: #232321; }
            // Liste â€” 48px par row, 4px gap
            LlmProviderListRow { x: 0px; y: 40px;  width: parent.width; provider_id: "openai";     selected_provider: root.selected_provider; name: "OpenAI";     route: "OAuth / Codex"; connected: root.openai_connected;     selected(id) => { root.selected_provider = id; } }
            LlmProviderListRow { x: 0px; y: 92px;  width: parent.width; provider_id: "anthropic";  selected_provider: root.selected_provider; name: "Anthropic";  route: "Claude CLI";    connected: root.anthropic_connected;  selected(id) => { root.selected_provider = id; } }
            LlmProviderListRow { x: 0px; y: 144px; width: parent.width; provider_id: "openrouter"; selected_provider: root.selected_provider; name: "OpenRouter"; route: "OAuth PKCE";    connected: root.openrouter_connected; selected(id) => { root.selected_provider = id; } }
        }

        Rectangle {
            x: 318px;
            y: 0px;
            width: parent.width - 318px;
            height: parent.height;
            background: #000000;
            clip: true;

            // -- Header banner : logo + nom CLI + version --
            Image {
                x: root.selected_provider == "openrouter" ? 29px : 24px;
                y: root.selected_provider == "openrouter" ? 30px : 26px;
                width: root.selected_provider == "openrouter" ? 22px : 30px;
                height: root.selected_provider == "openrouter" ? 22px : 30px;
                source: root.terminal_mark;
                image-fit: contain;
            }
            Text { x: 66px; y: 24px; width: 240px; height: 18px; text: root.terminal_cli; color: #ffffff; font-family: "Geist Mono"; font-size: 14px; font-weight: 800; vertical-alignment: center; }
            Text { x: 66px + (root.terminal_cli == "Claude Code" ? 104px : root.terminal_cli == "Codex Web" ? 86px : 142px); y: 24px; width: 90px; height: 18px; text: root.terminal_version; color: #55554f; font-family: "Geist Mono"; font-size: 13px; vertical-alignment: center; }
            // Signed-in status line
            Text { x: 66px; y: 44px; width: parent.width - 90px; height: 16px; text: root.selected_connected ? root.terminal_signin : ("Not signed in  " + root.terminal_signin); color: #eeeee8; font-family: "Geist Mono"; font-size: 12px; font-weight: 700; vertical-alignment: center; }
            Text { x: 66px; y: 62px; width: parent.width - 90px; height: 16px; text: root.terminal_plan; color: #6a6a64; font-family: "Geist Mono"; font-size: 12px; vertical-alignment: center; }

            // -- EncadrÃ© notice (mÃ©thode d'auth) --
            CliNoticeBox {
                x: 24px; y: 96px;
                width: parent.width - 48px; height: 50px;
                text: root.terminal_method;
            }

            // -- Prompt cliquable = CONNECT --
            Rectangle {
                x: 24px; y: 162px;
                width: parent.width - 48px; height: 34px;
                border-radius: 4px;
                background: connect_touch.pressed ? #1a1a18 : (connect_touch.has-hover ? #121211 : #0a0a09);
                Text { x: 14px; y: 0px; width: 18px; height: parent.height; text: ">"; color: #67e8d4; font-family: "Geist Mono"; font-size: 12px; vertical-alignment: center; }
                Text { x: 30px; y: 0px; width: parent.width - 120px; height: parent.height; text: root.terminal_cmd; color: #eeeee8e8; font-family: "Geist Mono"; font-size: 12px; vertical-alignment: center; }
                // Curseur bloc clignotant
                Rectangle {
                    x: 30px + root.terminal_cmd.character-count * 7.22px + 3px;
                    y: 9px; width: 7px; height: 15px;
                    background: #67e8d4;
                    opacity: (!root.selected_connected && root.cursor_on) ? 0.9 : 0.0;
                }
                Text { x: parent.width - 96px; y: 0px; width: 82px; height: parent.height; text: root.selected_connected ? "linked ?" : "press to run"; color: root.selected_connected ? #67e8d4 : #55554f; font-family: "Geist Mono"; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
                connect_touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.connect_provider(root.selected_provider);
                    }
                }
            }

            // -- Sortie session (lignes terminal) --
            Rectangle {
                x: 24px; y: 216px;
                width: parent.width - 48px; height: parent.height - 290px;
                background: #00000000;
                TerminalEventLine { y: 0px;   width: parent.width; keyword: true;  text: root.selected_connected ? "session: credential profile loaded from local store" : "session: waiting for connect command"; }
                TerminalEventLine { y: 24px;  width: parent.width; keyword: false; text: root.selected_provider == "openai" ? "auth route: ChatGPT Codex web OAuth grant" : root.selected_provider == "anthropic" ? "auth route: claude CLI credential store" : "auth route: openrouter.ai OAuth PKCE callback"; }
                TerminalEventLine { y: 48px;  width: parent.width; keyword: true;  text: "model catalog: " + root.terminal_models; active: root.selected_connected; }
                TerminalEventLine { y: 72px;  width: parent.width; keyword: false; text: "models: " + root.terminal_model_1; active: root.selected_connected; }
                TerminalEventLine { y: 96px;  width: parent.width; keyword: false; text: "models: " + root.terminal_model_2; active: root.selected_connected; }
                TerminalEventLine { y: 120px; width: parent.width; keyword: false; text: root.selected_provider == "anthropic" ? "reasoning: CLI model flag + plan / permission mode" : "reasoning: low, medium, high, xhigh where supported"; active: root.selected_connected; }
                TerminalEventLine { y: 144px; width: parent.width; keyword: false; text: "policy: keep connected â€” never ask again until token revoked"; active: root.selected_connected; }
            }

            // -- Barre de statut bas : seulement aprÃ¨s session rÃ©elle --
            Rectangle { visible: root.selected_connected; x: 24px; y: parent.height - 58px; width: parent.width - 48px; height: 1px; background: #1c1c1a; }
            CliStatusCol { visible: root.selected_connected; x: 24px;                          y: parent.height - 44px; width: 130px; label: "account"; value: "linked"; accent: true; }
            CliStatusCol { visible: root.selected_connected; x: (parent.width - 48px) * 0.30; y: parent.height - 44px; width: 140px; label: "auth"; value: "active"; accent: true; }
            CliStatusCol { visible: root.selected_connected; x: (parent.width - 48px) * 0.58; y: parent.height - 44px; width: 180px; label: "models"; value: "catalog"; accent: true; }
            CliStatusCol { visible: root.selected_connected; x: parent.width - 92px;          y: parent.height - 44px; width: 70px;  label: "quota"; value: "linked"; }
        }
    }
}

component BrainTab inherits Rectangle {
    in property <string> comp_id;
    in property <string> selected_component;
    in property <string> name;
    in property <image> icon;
    in property <bool> active: false;
    callback selected(string);
    property <bool> is_sel: root.selected_component == root.comp_id;
    width: 36px + root.name.character-count * 7.6px;
    height: 36px;
    background: root.is_sel ? #ffffff08 : (touch.has-hover ? #ffffff05 : #00000000);
    border-radius: 5px;
    animate background { duration: 140ms; easing: ease; }
    Image {
        x: 12px; y: (parent.height - 14px) / 2;
        width: 14px; height: 14px;
        source: root.icon;
        image-fit: contain;
        colorize: root.is_sel ? #ffbf48 : (touch.has-hover ? #eeeee8c0 : #6a6a64);
        animate colorize { duration: 140ms; easing: ease; }
    }
    Text {
        x: 32px; y: 0px;
        width: parent.width - 40px; height: parent.height;
        text: root.name;
        color: root.is_sel ? #ffffff : (touch.has-hover ? #eeeee8e0 : #eeeee8a8);
        font-family: "Geist Mono";
        font-size: 12px;
        font-weight: root.is_sel ? 700 : 450;
        vertical-alignment: center;
        animate color { duration: 140ms; easing: ease; }
    }
    Rectangle {
        x: 10px; y: parent.height - 2px;
        width: parent.width - 20px; height: 2px;
        border-radius: 1px;
        background: root.is_sel ? #ffbf48 : #00000000;
        animate background { duration: 200ms; easing: ease; }
    }
    touch := TouchArea {
        width: parent.width; height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.selected(root.comp_id); }
    }
}

// One amber metaball lobe — a solid circle orbiting a pivot. Several of these in the same
// opaque tint fuse into a single crisp morphing silhouette (no internal seams, no blur).
component BrainLobe inherits Rectangle {
    in property <length> cx;
    in property <length> cy;
    in property <length> diam;
    in property <length> orbit;
    in property <float> ang;
    in property <color> tint;
    width: root.diam;
    height: root.diam;
    border-radius: root.diam / 2;
    background: root.tint;
    x: root.cx + root.orbit * Math.cos(root.ang * 1rad) - root.diam / 2;
    y: root.cy + root.orbit * Math.sin(root.ang * 1rad) - root.diam / 2;
}

// Living amber core, rendered 100% natively by Slint (GPU-composited, zero readback, no CPU
// roundtrip). animation-tick() drives it at the display refresh; the lobe spin speeds are
// mutually irrational so the silhouette never loops, and the tint drifts amber <-> burnt.
component BrainCoreLive inherits Rectangle {
    // Continuous, ever-increasing time in milliseconds (never resets).
    property <float> t: animation-tick() / 1ms;
    // Hue drift amber <-> burnt-orange on two incommensurate sines (~6s + ~15s): never repeats.
    property <float> drift: 0.40 + 0.22 * Math.sin((t * 0.00105) * 1rad) + 0.12 * Math.sin((t * 0.00041 + 1.7) * 1rad);
    property <color> body: #ffbf48.mix(#be4a1d, drift);
    // Gentle non-periodic breathing of the core.
    property <float> breathe: 1.0 + 0.04 * Math.sin((t * 0.0007) * 1rad) + 0.02 * Math.sin((t * 0.00031) * 1rad);
    property <length> s: self.width;
    property <length> cx: self.width / 2;
    property <length> cy: self.height / 2;

    // Central body keeps every orbiting lobe fused to one connected mass.
    BrainLobe { cx: root.cx; cy: root.cy; orbit: 0px; ang: 0; diam: root.s * 0.60 * root.breathe; tint: root.body; }
    // Orbiting lobes — speeds in rad/ms; ~one turn per 2s = 0.00314, both directions, irrational.
    BrainLobe { cx: root.cx; cy: root.cy; orbit: root.s * 0.16; ang: root.t *  0.00314 + 0.0; diam: root.s * 0.40; tint: root.body; }
    BrainLobe { cx: root.cx; cy: root.cy; orbit: root.s * 0.20; ang: root.t * -0.00298 + 2.0; diam: root.s * 0.34; tint: root.body; }
    BrainLobe { cx: root.cx; cy: root.cy; orbit: root.s * 0.14; ang: root.t *  0.00331 + 4.2; diam: root.s * 0.30; tint: root.body; }
    BrainLobe { cx: root.cx; cy: root.cy; orbit: root.s * 0.22; ang: root.t * -0.00275 + 1.0; diam: root.s * 0.32; tint: root.body; }
    BrainLobe { cx: root.cx; cy: root.cy; orbit: root.s * 0.18; ang: root.t *  0.00352 + 3.1; diam: root.s * 0.26; tint: root.body; }
    BrainLobe { cx: root.cx; cy: root.cy; orbit: root.s * 0.12; ang: root.t * -0.00289 + 5.0; diam: root.s * 0.24; tint: root.body; }
}

component BrainSurface inherits Rectangle {
    in property <string> mode;
    in property <image> brain_motion_image;
    in-out property <string> selected_component: "memory";
    in-out property <string> safe_tune_text: "";
    callback brain_action(string);
    callback brain_tune(string);
    visible: root.mode == "brain";
    background: #0e0e0f;
    property <length> content_width: min(1040px, root.width - 96px);
    property <length> chat_clearance: 184px;
    property <bool> cursor_on: Math.mod(Math.floor(animation-tick() / 540ms), 2) == 0;
    property <string> b_title:
        root.selected_component == "memory" ? "EXPERIENCE LEDGER" :
        root.selected_component == "personality" ? "LESSONS" :
        root.selected_component == "reasoning" ? "CODEACT" :
        root.selected_component == "affinity" ? "GODEL GATE" : "RETRIEVAL";
    property <string> b_sub:
        root.selected_component == "memory" ? "Recents + archive Â· session evidence" :
        root.selected_component == "personality" ? "Failure/success extraction Â· safe notes" :
        root.selected_component == "reasoning" ? "General + specialized command index" :
        root.selected_component == "affinity" ? "Promotion proof Â· rollback guard" : "Bounded context packs Â· task routing";
    property <string> b_method:
        root.selected_component == "memory" ? "Reads recent and archived sessions as evidence, not as trusted instructions." :
        root.selected_component == "personality" ? "Turns a real task result into a small lesson the user can refine safely." :
        root.selected_component == "reasoning" ? "Separates global CodeAct commands from specialized tool commands; full templates stay hidden until needed." :
        root.selected_component == "affinity" ? "Godel promotes only procedures with evidence, scope, safety and rollback." :
        "Feeds the LLM only the promoted skills and task keys needed for the next run.";
    property <string> b_cmd:
        root.selected_component == "memory" ? "/brain_source_ note=" :
        root.selected_component == "personality" ? "/brain_lesson_ note=" :
        root.selected_component == "reasoning" ? "/brain_codeact_ note=" :
        root.selected_component == "affinity" ? "/brain_gate_ note=" : "/brain_retrieval_ note=";
    property <string> b_tune_hint:
        root.selected_component == "memory" ? "write which session evidence should matter" :
        root.selected_component == "personality" ? "write a concrete lesson from a real run" :
        root.selected_component == "reasoning" ? "write when a CodeAct command should be preferred" :
        root.selected_component == "affinity" ? "write a stricter promotion preference" :
        "write when this skill should be recalled";
    property <image> b_mark:
        root.selected_component == "memory" ? @image-url("data:image/svg+xml;base64,") :
        root.selected_component == "personality" ? @image-url("data:image/svg+xml;base64,") :
        root.selected_component == "reasoning" ? @image-url("data:image/svg+xml;base64,") :
        root.selected_component == "affinity" ? @image-url("data:image/svg+xml;base64,") :
        @image-url("data:image/svg+xml;base64,");

    // Cœur ambre vivant (natif Slint, composité GPU, zéro readback) — arrière-plan du terminal,
    // posé en bas à droite, derrière la barre de chat. Hors du rectangle clippé pour déborder.
    BrainCoreLive {
        x: root.width * 0.60 - 380px;
        y: root.height - 470px;
        width: 760px; height: 760px;
        opacity: 0.5;
    }

    // Tout le canvas EST le terminal : onglets en haut, sortie session en dessous.
    Rectangle {
        x: (parent.width - root.content_width) / 2;
        y: 36px;
        width: root.content_width;
        height: max(430px, parent.height - root.chat_clearance - 36px);
        background: #00000000;
        clip: true;

        // -- Barre d'onglets : catégories du brain fusionnées au terminal --
        Text { x: 2px; y: 0px; width: 54px; height: 36px; text: "BRAIN"; color: #3c3c39; font-family: "Geist Mono"; font-size: 10px; font-weight: 700; vertical-alignment: center; }
        HorizontalLayout {
            x: 58px; y: 0px; width: parent.width - 58px; height: 36px;
            spacing: 4px; alignment: start;
            BrainTab { comp_id: "memory";      selected_component: root.selected_component; name: "memory";      icon: @image-url("data:image/svg+xml;base64,"); selected(id) => { root.selected_component = id; } }
            BrainTab { comp_id: "personality"; selected_component: root.selected_component; name: "personality"; icon: @image-url("data:image/svg+xml;base64,"); selected(id) => { root.selected_component = id; } }
            BrainTab { comp_id: "reasoning";   selected_component: root.selected_component; name: "CodeAct";     icon: @image-url("data:image/svg+xml;base64,"); selected(id) => { root.selected_component = id; } }
            BrainTab { comp_id: "affinity";    selected_component: root.selected_component; name: "Godel Gate";  icon: @image-url("data:image/svg+xml;base64,"); selected(id) => { root.selected_component = id; } }
            BrainTab { comp_id: "strategy";    selected_component: root.selected_component; name: "Retrieval";   icon: @image-url("data:image/svg+xml;base64,"); selected(id) => { root.selected_component = id; } }
        }
        Rectangle { x: 0px; y: 46px; width: parent.width; height: 1px; background: #232321; }

        // Header : logo + nom + statut
        Image { x: 0px; y: 66px; width: 30px; height: 30px; source: root.b_mark; image-fit: contain; colorize: #ffbf48; }
        Text { x: 42px; y: 64px; width: 260px; height: 18px; text: "Brain core"; color: #ffffff; font-family: "Geist Mono"; font-size: 14px; font-weight: 800; vertical-alignment: center; }
        Text { x: 42px; y: 84px; width: parent.width - 60px; height: 16px; text: root.b_title; color: #eeeee8; font-family: "Geist Mono"; font-size: 12px; font-weight: 700; vertical-alignment: center; }
        Text { x: 42px; y: 102px; width: parent.width - 60px; height: 16px; text: root.b_sub; color: #6a6a64; font-family: "Geist Mono"; font-size: 12px; vertical-alignment: center; }

        // Encadré notice (rôle du composant)
        CliNoticeBox {
            x: 0px; y: 136px;
            width: parent.width; height: 50px;
            text: root.b_method;
        }

        // Prompt libre: safe-tuning text only, never raw internal mutation.
        Rectangle {
            x: 0px; y: 202px;
            width: parent.width; height: 34px;
            border-radius: 4px;
            background: save_touch.pressed ? #1a1a18 : (save_touch.has-hover ? #121211 : #0a0a09);
            Text { x: 14px; y: 0px; width: 18px; height: parent.height; text: ">"; color: #ffbf48; font-family: "Geist Mono"; font-size: 12px; vertical-alignment: center; }
            Text { x: 30px; y: 0px; width: root.b_cmd.character-count * 7.22px + 2px; height: parent.height; text: root.b_cmd; color: #eeeee8e8; font-family: "Geist Mono"; font-size: 12px; vertical-alignment: center; }
            TextInput {
                x: 30px + root.b_cmd.character-count * 7.22px + 4px;
                y: 0px;
                width: parent.width - root.b_cmd.character-count * 7.22px - 138px;
                height: parent.height;
                text <=> root.safe_tune_text;
                color: #eeeee8e8;
                font-family: "Geist Mono";
                font-size: 12px;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: #26d8c34a;
                selection-foreground-color: #f7f7f1;
                text-cursor-width: 1px;
                accepted => { root.brain_tune(root.safe_tune_text); }
            }
            Text {
                visible: root.safe_tune_text == "";
                x: 30px + root.b_cmd.character-count * 7.22px + 4px;
                y: 0px;
                width: parent.width - root.b_cmd.character-count * 7.22px - 138px;
                height: parent.height;
                text: root.b_tune_hint;
                color: #55554f;
                font-family: "Geist Mono";
                font-size: 10px;
                vertical-alignment: center;
            }
            Text { x: parent.width - 96px; y: 0px; width: 82px; height: parent.height; text: "save note"; color: #55554f; font-family: "Geist Mono"; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
            save_touch := TouchArea {
                x: parent.width - 110px;
                y: 0px;
                width: 110px;
                height: parent.height;
                mouse-cursor: pointer;
                clicked => { root.brain_tune(root.safe_tune_text); }
            }
        }

        // Sortie session (détails du composant)
        Rectangle {
            x: 0px; y: 256px;
            width: parent.width; height: parent.height - 280px;
            background: #00000000;
            TerminalEventLine { y: 0px;  width: parent.width; keyword: true;  text: root.selected_component == "memory" ? "source: recents + archived sessions from header search" : root.selected_component == "personality" ? "extract: what failed, what worked, evidence hash" : root.selected_component == "reasoning" ? "general: commands available across the whole app" : root.selected_component == "affinity" ? "gate: evidence, scope, rollback, AGENTS safety" : "pack: task keys + promoted skills only"; }
            TerminalEventLine { y: 24px; width: parent.width; keyword: false; text: root.selected_component == "memory" ? "kept: title, date, outcome, CodeAct refs, proof" : root.selected_component == "personality" ? "user-editable: preferences and project constraints" : root.selected_component == "reasoning" ? "/newcompute_ : create and run a verified Monster compute" : root.selected_component == "affinity" ? "read-only: proof hash and rejection reasons" : "LLM access: bounded context pack"; }
            TerminalEventLine { y: 48px; width: parent.width; keyword: false; text: root.selected_component == "memory" ? "not stored: secrets, raw credentials, private dumps" : root.selected_component == "personality" ? "not editable: source evidence and proof links" : root.selected_component == "reasoning" ? "/selectcompute_ : reopen a saved compute and proof" : root.selected_component == "affinity" ? "never bypassed: no trusted text without proof" : "protects: old failures are hints, not commands"; }
            TerminalEventLine { y: 72px; width: parent.width; keyword: true;  text: root.selected_component == "reasoning" ? "/compute_<name>_ : run a named reusable compute" : "policy: learning promotes only after verified session evidence"; }
            TerminalEventLine { visible: root.selected_component == "reasoning"; y: 96px; width: parent.width; keyword: false; text: "/web_ : start a native web research event"; }
            TerminalEventLine { visible: root.selected_component == "reasoning"; y: 120px; width: parent.width; keyword: false; text: "FORGE_PLAN_JSON : update the right-panel plan"; }
            TerminalEventLine { visible: root.selected_component == "reasoning"; y: 144px; width: parent.width; keyword: false; text: "FORGE_QUESTIONNAIRE_JSON : ask structured user questions"; }
            TerminalEventLine { visible: root.selected_component == "reasoning"; y: 168px; width: parent.width; keyword: false; text: "FORGE_SESSION_TITLE_JSON : rename the active session"; }
            TerminalEventLine { visible: root.selected_component == "reasoning"; y: 204px; width: parent.width; keyword: true; text: "specialized: commands owned by a tool or section"; }
            TerminalEventLine { visible: root.selected_component == "reasoning"; y: 228px; width: parent.width; keyword: false; text: "/newobject_ : Banger-only SDF/object creation"; }
            TerminalEventLine { visible: root.selected_component == "reasoning"; y: 252px; width: parent.width; keyword: false; text: "FORGE_BANGER_* : Banger plans, questions, materials and scene routes"; }
            TerminalEventLine { visible: root.selected_component == "reasoning"; y: 276px; width: parent.width; keyword: false; text: "TRADING_* : future market, backtest and alert commands"; }
        }
    }
}

component WorkspaceHeader inherits Rectangle {
    in property <string> active_section;
    in property <string> section_title;
    callback navigate(string);
    callback toggle_right_panel();
    height: 52px;
    background: #0e0e0f;
    Image { x: 24px; y: 15px; width: 18px; height: 18px; source: @image-url("data:image/svg+xml;base64,"); }
    Text { x: 74px; y: 0px; width: 130px; height: parent.height; text: root.active_section == "trading" ? "PAPERTRADING" : root.active_section == "real-estate" ? "Forge" : "Choose workspace"; color: #b4b4af80; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    Text { x: 204px; y: 0px; width: 20px; height: parent.height; text: "/"; color: #eeeee857; font-size: 15px; vertical-alignment: center; }
    Text { x: 230px; y: 0px; width: 280px; height: parent.height; text: root.section_title; color: root.active_section == "trading" ? #68d0c4f5 : #eeeee894; font-size: 14px; font-weight: 700; vertical-alignment: center; }
    NavIcon { x: parent.width - 128px; y: 10px; icon: @image-url("data:image/svg+xml;base64,"); clicked => { root.navigate("forge"); } }
    NavIcon { x: parent.width - 84px; y: 10px; icon: @image-url("data:image/svg+xml;base64,"); clicked => { root.navigate("webexplorer"); } }
    NavIcon { x: parent.width - 40px; y: 10px; icon: @image-url("data:image/svg+xml;base64,"); clicked => { root.toggle_right_panel(); } }
}

component DropCanvas inherits Rectangle {
    in property <string> active_section;
    in property <string> canvas_title;
    in property <string> canvas_hint;
    callback activate_control(string);
    visible: root.active_section != "webexplorer";
    background: #0e0e0f;
    Rectangle { x: 328px; y: 86px; width: 22px; height: 22px; background: #00000000; border-width: 1px; border-color: #eeeee857; }
    Rectangle { x: 898px; y: 86px; width: 22px; height: 22px; background: #00000000; border-width: 1px; border-color: #eeeee857; }
    Rectangle { x: 328px; y: 416px; width: 22px; height: 22px; background: #00000000; border-width: 1px; border-color: #eeeee857; }
    Rectangle { x: 898px; y: 416px; width: 22px; height: 22px; background: #00000000; border-width: 1px; border-color: #eeeee857; }
    Image { x: 592px; y: 178px; width: 64px; height: 64px; source: @image-url("data:image/svg+xml;base64,"); }
    Text { x: 468px; y: 260px; width: 314px; height: 32px; text: root.canvas_title; color: #eeeee8f5; font-size: 19px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    Text {
        x: 394px;
        y: 296px;
