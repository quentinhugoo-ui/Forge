{
  "name": "@forge/ingen-electron-shell",
  "version": "0.1.0",
  "private": true,
  "description": "Deliberate Electron/React product shell lane for InGen front migration.",
  "type": "module",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "generate:ipc": "node scripts/export-rust-ipc.mjs",
    "generate:front-ledger": "npm run generate:ipc",
    "factory:generate": "npm run generate:front-ledger",
    "factory:check": "npm run factory:generate && vitest run tests/final-cutover-audit.test.ts",
    "capture:header-goldens": "npm run generate:front-ledger && node scripts/capture-header-goldens.mjs",
    "capture:sidebar-goldens": "npm run generate:front-ledger && node scripts/capture-sidebar-goldens.mjs",
    "capture:panels-chat-bottom-goldens": "npm run generate:front-ledger && node scripts/capture-panels-chat-bottom-goldens.mjs",
    "audit:final-cutover": "npm run generate:front-ledger && node scripts/final-cutover-audit.mjs",
    "typecheck": "npm run generate:front-ledger && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json",
    "test": "npm run audit:final-cutover && vitest run",
    "build": "npm run audit:final-cutover && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json && vite build",
    "dev": "npm run generate:front-ledger && vite --host 127.0.0.1",
    "start": "npm run build && electron .",
    "launch": "electron ."
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@vitejs/plugin-react": "6.0.2",
    "cesium": "^1.142.0",
    "lucide-react": "1.17.0",
    "pdfjs-dist": "^6.0.227",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.184.0",
    "vite-plugin-cesium": "^1.2.23"
  },
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@types/node": "25.9.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "^0.184.1",
    "electron": "42.3.3",
    "typescript": "6.0.3",
    "vite": "8.0.16",
    "vitest": "4.1.8"
  },
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.12.1"
  }
}
