{
  "version": 1,
  "entrypoints": [
    "ui/dist/forge-section-registry.js",
    "ui/dist/forge-tauri-bridge.js",
    "ui/dist/forge-shell-runtime.js",
    "ui/dist/forge-real-estate.js",
    "ui/dist/forge-trading.js",
    "ui/dist/forge-banger.js",
    "ui/dist/forge-boot.js",
    "ui/dist/forge-window-controls.js",
    "ui/dist/forge-hardware.js",
    "ui/dist/forge-sidebar.js",
    "ui/dist/forge-shell-guardian.js",
    "ui/dist/forge-search-palette.js",
    "ui/dist/forge-webexplorer-config.js",
    "ui/dist/forge-app.js"
  ],
  "sections": [
    {
      "id": "shell",
      "owner": "Forge shell",
      "files": [
        "ui/src/shell/surface.ts",
        "ui/dist/forge-shell-runtime.js",
        "ui/dist/forge-real-estate.js",
        "ui/dist/forge-trading.js",
        "ui/dist/forge-banger.js",
        "ui/src/shell/types.ts",
        "ui/src/shell/shell-machine.ts",
        "ui/src/shell/section-registry.ts",
        "ui/src/shell/shell-actions.ts",
        "ui/src/shell/tauri-client.ts",
        "src-tauri/src/forge_kernel.rs",
        "ui/src/sections/manifests.ts",
        "ui/src/sections/real-estate/tools.ts",
        "ui/src/sections/real-estate/tool-renderer.ts",
        "ui/src/sections/real-estate/onboarding.ts",
        "ui/src/sections/real-estate/onboarding-runtime.ts",
        "ui/src/sections/real-estate/language-runtime.ts",
        "ui/src/sections/real-estate/mode-runtime.ts",
        "ui/src/sections/real-estate/panel-runtime.ts",
        "ui/src/sections/real-estate/runtime-context.ts",
        "ui/src/main.ts",
        "ui/dist/forge-section-registry.js",
        "ui/dist/forge-tauri-bridge.js",
        "ui/dist/forge-boot.js",
        "ui/dist/forge-window-controls.js",
        "ui/dist/forge-hardware.js",
        "ui/dist/forge-sidebar.js",
        "ui/src/shell/legacy-section-registry.ts",
        "ui/src/shell/tauri-bridge.ts",
        "ui/src/shell/boot.ts",
        "ui/src/shell/window-controls.ts",
        "ui/src/shell/hardware.ts",
        "ui/src/shell/sidebar.ts",
        "ui/dist/forge-shell-guardian.js",
        "ui/src/shell/guardian.ts",
        "ui/dist/forge-search-palette.js",
        "ui/src/shell/search-palette.ts"
      ],
      "lifecycle": "always-active"
    },
    {
      "id": "alpha",
      "owner": "Alpha canvas",
      "files": [
        "ui/src/shell/surface.ts"
      ],
      "lifecycle": "shell-section"
    },
    {
      "id": "forge",
      "owner": "Legacy Forge page",
      "files": [
        "ui/src/shell/surface.ts"
      ],
      "lifecycle": "shell-section"
    },
    {
      "id": "webexplorer",
      "owner": "WebExplorer",
      "files": [
        "ui/dist/forge-webexplorer-config.js",
        "ui/src/sections/webexplorer/config.ts",
        "ui/src/shell/surface.ts",
        "ui/dist/forge-real-estate.js"
      ],
      "lifecycle": "active-toggle",
      "nativePresentCommands": [
        "webexplorer_native_present"
      ],
      "nativeHideCommands": [
        "webexplorer_native_hide"
      ]
    },
    {
      "id": "real-estate",
      "owner": "Agence immo mode",
      "files": [
        "ui/dist/forge-webexplorer-config.js",
        "ui/src/sections/webexplorer/config.ts",
        "ui/src/shell/surface.ts",
        "ui/src/sections/real-estate/language-runtime.ts",
        "ui/src/sections/real-estate/mode-runtime.ts",
        "ui/src/sections/real-estate/panel-runtime.ts"
      ],
      "lifecycle": "active-toggle"
    },
    {
      "id": "real-estate-main",
      "owner": "Accueil agence immo",
      "files": [
        "ui/src/shell/surface.ts",
        "ui/dist/forge-real-estate.js",
        "ui/src/sections/real-estate/language-runtime.ts",
        "ui/src/sections/real-estate/mode-runtime.ts",
        "ui/src/sections/real-estate/panel-runtime.ts"
      ],
      "lifecycle": "active-toggle"
    },
    {
      "id": "trading",
      "owner": "Trading workspace",
      "files": [
        "ui/src/sections/trading/surface.ts",
        "ui/dist/forge-trading.js",
        "ui/src/sections/trading/controller.ts",
        "ui/src/sections/trading/catalog.ts",
        "ui/src/sections/trading/state.ts",
        "ui/src/shell/surface.ts"
      ],
      "lifecycle": "open-close",
      "nativePresentCommands": [
        "bloomberg_live_native_present"
      ],
      "nativeHideCommands": [
        "bloomberg_live_native_hide"
      ]
    },
    {
      "id": "banger",
      "owner": "Banger viewport",
      "files": [
        "ui/src/sections/banger/surface.ts",
        "ui/dist/forge-banger.js",
        "ui/src/sections/banger/controller.ts",
        "ui/src/sections/banger/catalog.ts"
      ],
      "lifecycle": "open-close"
    }
  ],
  "sensitiveCommands": [
    {
      "command": "webexplorer_native_present",
      "owner": "webexplorer",
      "requiresBridge": true,
      "requiresActiveSection": true,
      "forbidDirectInvoke": true
    },
    {
      "command": "bloomberg_live_native_present",
      "owner": "trading",
      "requiresBridge": true,
      "requiresActiveSection": true,
      "forbidDirectInvoke": true
    },
    {
      "command": "get_hardware_info",
      "owner": "shell",
      "requiresBridge": true,
      "allowRawFallback": true,
      "bootSafe": true
    },
    {
      "command": "list_forge_jobs",
      "owner": "shell",
      "requiresBridge": true,
      "allowRawFallback": true,
      "bootSafe": true
    }
  ],
  "sharedGlobalPrefixes": [
    "__forgeAlpha",
    "__forgeAtlas",
    "__forgeBoom",
    "__forgeClose",
    "__forgeOpen",
    "__forgePending",
    "__forgeRealEstate",
    "__forgeSchedule",
    "__forgeSwitch",
    "__forgeTrading",
    "__forgeWebExplorer"
  ]
}
