{
  "schemaVersion": 1,
  "scope": "real-estate-public-mega-harvester",
  "updatedAt": "2026-05-15",
  "policy": {
    "defaultMode": "metadata-first",
    "rawDataRule": "store raw payloads locally, exchange compact manifests, hashes, previews and parser proofs",
    "forbidden": [
      "captcha bypass",
      "paywall bypass",
      "login scraping without explicit tenant-owned connector",
      "personal owner data from restricted foncier datasets"
    ]
  },
  "parsers": {
    "json": "structured_json",
    "geojson": "structured_geojson",
    "csv": "streaming_table",
    "txt": "line_or_delimited_text",
    "csv.gz": "compressed_streaming_table",
    "xlsx": "workbook_table",
    "xls": "workbook_table",
    "parquet": "columnar_table",
    "xml": "structured_xml",
    "rss": "feed_xml",
    "atom": "feed_xml",
    "pdf": "pdf_text_then_table_then_ocr_if_needed",
    "html": "html_metadata_and_links",
    "zip": "archive_manifest_then_recursive_parse",
    "wfs": "geospatial_feature_service",
    "wms": "geospatial_map_service",
    "gtfs": "zip_csv_gtfs",
    "gtfs-rt": "protobuf_gtfs_rt"
  },
  "sources": [
